---
// src/pages/[slug].astro - Forzar compilación limpia Astro v5
import { getCollection, render } from 'astro:content';
import ContactForm from '../components/ContactForm.astro';
import BackToTop from '../components/BackToTop.astro';
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../lib/formatDate';
import { slugify } from '../lib/slugify';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { resolveAuthor } from '../lib/author';

// 1. Generar las rutas estáticas para cada artículo
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  
  // Ordenar cronológicamente (más antiguos primero)
  const sortedEntries = blogEntries.sort(
    (a, b) => a.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return sortedEntries.map((entry, index) => {
    const prevPost = index > 0 ? sortedEntries[index - 1] : null;
    const nextPost = index < sortedEntries.length - 1 ? sortedEntries[index + 1] : null;

    return {
      params: { slug: entry.id }, 
      props: { entry, prevPost, nextPost },
    };
  });
}

const { entry, prevPost, nextPost } = Astro.props;

const authors = await getCollection('autores');
const authorEntry = resolveAuthor(authors, entry.data.authorSlug, entry.data.author);
const authorBio = authorEntry?.body || entry.data.authorBio || 'Biografía del autor próximamente.';
const authorImage = authorEntry?.data.image || entry.data.authorImage || '/images/author-default.svg';
const hasInlineFeaturedImage = Boolean(entry.data.image && entry.body?.includes(entry.data.image));
const featuredImageCaption = entry.id === 'curaduria-img-pat'
  ? 'Identidad visual San Juan en Purificación 2012 - Declaratoria de Patrimonio Cultural Inmaterial'
  : undefined;

// 2. SOLUCIÓN COMPATIBLE CON ASTRO v5: Renderizado externo y asíncrono
const { Content, headings } = await render(entry);

// 3. Algoritmo de artículos relacionados libre de colapsos
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(post => post.id !== entry.id)
  .map(post => {
    let score = 0;
        if (post.data.category.some(category => entry.data.category.includes(category))) score += 3;
    const commonTags = post.data.tags.filter(tag => entry.data.tags.includes(tag));
    score += commonTags.length;
    return { post, score };
  })
  .filter(item => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 2)
  .map(item => item.post);
const fallbackRelated = allPosts
  .filter((post) => post.id !== entry.id && !relatedPosts.some((related) => related.id === post.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const finalRelatedPosts = [...relatedPosts, ...fallbackRelated].slice(0, 3);
const readingMinutes = Math.max(1, Math.ceil((entry.body?.split(/\s+/).filter(Boolean).length ?? 0) / 200));

const articleUrl = new URL(`/${entry.id}/`, Astro.site ?? Astro.url).href;
const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: articleUrl,
    datePublished: entry.data.pubDate.toISOString(),
    author: {
        '@type': 'Person',
        name: entry.data.author,
    },
    publisher: {
        '@type': 'Organization',
        name: 'Corporación Cultura y Desarrollo',
    },
};
const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        {
            '@type': 'ListItem',
            position: 1,
            name: 'Inicio',
            item: new URL('/', Astro.site ?? Astro.url).href,
        },
        {
            '@type': 'ListItem',
            position: 2,
            name: entry.data.title,
            item: articleUrl,
        },
    ],
};
---

<Layout
    title={`${entry.data.title} | Blog Cultura y Desarrollo`}
    description={entry.data.description}
    type="article"
    author={entry.data.author}
    publishedDate={entry.data.pubDate}
>
<Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <style>
        .article-container {
            max-width: 750px;
            margin: 0 auto;
            padding: 3rem 1.5rem 0;
            padding-top: 95px;
        }
        .article-header {
            border-bottom: 1px solid var(--color-border);
            padding-bottom: 1rem;
        }
        .article-header h1 {
            color: var(--color-primary);
            font-size: clamp(2.1rem, 4vw, 2.7rem);
            line-height: 1.2;
            margin: 0 0 0.75rem;
        }
        .article-header .post-category-list {
            display: flex;
            margin: 0 0 1.25rem;
        }
        .meta-info {
            align-items: center;
            color: var(--color-muted);
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem 0.75rem;
            font-size: 0.9rem;
            justify-content: flex-start;
            margin-bottom: 0.55rem;
        }
        .meta-author {
            align-items: center;
            display: inline-flex;
            flex-shrink: 0;
            gap: 0.75rem;
            white-space: nowrap;
        }
        .meta-author > span {
            white-space: nowrap;
        }
        .meta-author img {
            border-radius: 50%;
            object-fit: cover;
        }
        .meta-details {
            align-items: center;
            display: inline-flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .meta-divider {
            color: var(--color-muted);
        }
        .article-content {
            margin-top: 2rem;
            font-size: 1.1rem;
        }
        .article-disclaimer {
            margin: 2rem 0 1.5rem;
            text-align: right;
        }
        .article-disclaimer-trigger {
            background: transparent;
            border: 1px solid var(--color-border);
            border-radius: 999px;
            color: var(--color-primary);
            cursor: pointer;
            font: inherit;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            padding: 0.55rem 0.9rem;
            text-transform: uppercase;
        }
        .article-disclaimer-trigger:hover,
        .article-disclaimer-trigger:focus-visible {
            background: var(--color-bg-alt);
            border-color: var(--color-secondary);
            text-decoration: none;
        }
        .disclaimer-modal {
            border: 0;
            border-radius: 10px;
            box-shadow: 0 18px 50px rgba(36, 19, 15, 0.24);
            color: var(--color-text);
            max-width: 620px;
            padding: 2rem;
            width: calc(100% - 2rem);
        }
        .disclaimer-modal::backdrop {
            background: rgba(36, 19, 15, 0.45);
        }
        .disclaimer-modal h2 {
            color: var(--color-primary);
            margin: 0 0 0.9rem;
        }
        .disclaimer-modal p {
            line-height: 1.7;
            margin: 0;
        }
        .disclaimer-modal-close {
            background: var(--color-primary);
            border: 0;
            border-radius: 4px;
            color: var(--color-on-primary);
            cursor: pointer;
            margin-top: 1rem;
            padding: 0.7rem 1rem;
        }
        .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin: 0 0 1.5rem;
        }
        .tag-item {
            background: var(--color-bg-alt);
            border: 1px solid var(--color-border);
            border-radius: 4px;
            color: var(--color-text);
            font-size: 0.85rem;
            padding: 0.3rem 0.7rem;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .tag-item:hover,
        .tag-item:focus-visible {
            border-color: var(--color-secondary);
            color: var(--color-secondary);
            text-decoration: none;
        }
        .featured-image {
            border-radius: 8px;
            display: block;
            height: auto;
            margin-top: 1rem;
            max-height: 720px;
            max-width: 100%;
            object-fit: contain;
            width: 100%;
        }
        .featured-figure {
            margin: 1rem 0 0;
        }
        .featured-figure figcaption {
            color: var(--color-muted);
            font-size: 0.9rem;
            margin-top: 0.6rem;
            text-align: center;
        }
        :global(.article-inline-image) {
            margin: 0 auto 1.5rem;
            max-width: 520px;
        }
        :global(.article-inline-image img) {
            border-radius: 8px;
            display: block;
            height: auto;
            max-height: 720px;
            max-width: 100%;
            object-fit: contain;
            width: 100%;
        }
        :global(.article-inline-image figcaption) {
            color: var(--color-muted);
            font-size: 0.9rem;
            margin-top: 0.5rem;
            text-align: center;
        }
        :global(.article-video) {
            margin: 0 auto 1.5rem;
            max-width: 720px;
        }
        :global(.article-video iframe),
        :global(.article-video video) {
            aspect-ratio: 16 / 9;
            border: 0;
            border-radius: 8px;
            display: block;
            height: auto;
            width: 100%;
        }
        :global(.article-video video) {
            background: #1f2933;
            object-fit: contain;
        }
        :global(.article-video figcaption) {
            color: var(--color-muted);
            font-size: 0.9rem;
            margin-top: 0.5rem;
            text-align: center;
        }
        :global(.article-post-share) {
            align-items: center;
            border-top: 1px solid var(--color-border);
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
            justify-content: center;
            margin-top: 2rem;
            padding-top: 1.25rem;
        }
        :global(.article-post-share-label) {
            color: var(--color-primary);
            flex-basis: 100%;
            font-size: 0.95rem;
            font-weight: 600;
            margin: 0 0 0.15rem;
            text-align: center;
        }
        :global(.article-post-share a),
        :global(.article-post-share button) {
            align-items: center;
            background: var(--color-bg-alt);
            border: 1px solid var(--color-border);
            border-radius: 4px;
            color: var(--color-primary);
            cursor: pointer;
            display: inline-flex;
            justify-content: center;
            min-height: 2.4rem;
            min-width: 2.4rem;
            padding: 0.45rem;
            text-decoration: none;
        }
        :global(.article-post-share a:hover),
        :global(.article-post-share a:focus-visible),
        :global(.article-post-share button:hover),
        :global(.article-post-share button:focus-visible) {
            background: var(--color-secondary);
            border-color: var(--color-secondary);
            color: var(--color-on-primary);
        }
        :global(.article-post-share svg) {
            fill: currentColor;
            height: 1.25rem;
            width: 1.25rem;
        }
        :global(.article-post-share-status) {
            color: var(--color-muted);
            flex-basis: 100%;
            font-size: 0.8rem;
            min-height: 1.2em;
            text-align: center;
        }
        .article-comment-cta {
            margin: 1.25rem 0 0;
            text-align: center;
        }
        .article-comment-cta a {
            color: var(--color-secondary);
            font-weight: 700;
        }
        .pagination-container {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid var(--color-border);
        }
        .pagination-btn {
            flex: 1;
            padding: 1rem;
            background: var(--color-bg-alt);
            border: 1px solid var(--color-border);
            border-radius: 6px;
            text-decoration: none;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
        }
        .pagination-btn:hover, .history-btn:hover {
            border-color: var(--color-secondary);
            background: var(--color-bg);
        }
        .pagination-btn .label, .history-btn .label {
            font-size: 0.8rem;
            color: var(--color-muted);
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        .pagination-btn .title, .history-btn .title {
            font-size: 0.95rem;
            color: var(--color-primary);
            font-weight: 700;
            line-height: 1.3;
        }
        .pagination-btn.next {
            text-align: left;
            align-items: flex-start;
        }
        .pagination-btn.prev {
            text-align: right;
            align-items: flex-end;
        }
        .history-container {
            margin-top: 2rem;
            display: none;
            margin-bottom: 1.5rem;
        }
        .history-btn {
            display: flex;
            flex-direction: column;
            padding: 1rem;
            border: 1px dashed var(--color-secondary);
            background: #fbf4ef;
            border-radius: 6px;
            text-decoration: none;
            transition: all 0.2s;
        }
        .rating-wrap {
            border-top: 1px solid var(--color-border);
            margin-top: 2.5rem;
            padding-top: 1.75rem;
        }
        .rating-head {
            align-items: center;
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            justify-content: space-between;
            margin-bottom: 0.75rem;
        }
        .rating-title {
            color: var(--color-primary);
            font-size: 1.05rem;
            font-weight: 700;
            margin: 0;
        }
        .rating-summary {
            color: var(--color-muted);
            font-size: 0.9rem;
        }
        .star-rating {
            display: inline-flex;
            gap: 0.35rem;
        }
        .star-button {
            background: transparent;
            border: 0;
            color: #d1d5db;
            cursor: pointer;
            font-size: 1.8rem;
            line-height: 1;
            padding: 0;
            transition: transform 0.15s ease, color 0.15s ease;
        }
        .star-button:hover,
        .star-button:focus-visible {
            color: #f4b740;
            transform: scale(1.08);
        }
        .star-button.is-active {
            color: #f4b740;
        }
        .rating-note {
            color: var(--color-text);
            font-size: 0.9rem;
            margin-top: 0.75rem;
        }
        .related-section {
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 2px solid var(--color-border);
        }
        .related-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        }
        .related-card {
            background: var(--color-bg-alt);
            border-radius: 6px;
            border-top: 3px solid var(--color-secondary);
            padding: 1.25rem;
        }
        .related-card h3 {
            font-size: 1.1rem;
            margin: 0 0 0.5rem;
        }
        .related-card p {
            font-size: 0.9rem;
            margin: 0 0 0.75rem;
        }
        .author-trigger {
            align-items: center;
            background: transparent;
            border: 0;
            cursor: pointer;
            display: inline-flex;
            flex-direction: column;
            gap: 0.15rem;
            padding: 0;
        }
        .author-trigger:hover,
        .author-trigger:focus-visible {
            background: transparent;
        }

        .author-bio-trigger {
            background: transparent;
            border: 0;
            color: var(--color-secondary);
            cursor: pointer;
            font: inherit;
            font-size: 0.62rem;
            font-weight: 700;
            padding: 0;
            white-space: nowrap;
        }

        .author-bio-trigger:hover,
        .author-bio-trigger:focus-visible {
            background: transparent;
            text-decoration: underline;
        }
        .author-trigger img {
            display: block;
            transition: transform 0.2s ease;
        }
        .author-trigger:hover img, .author-trigger:focus-visible img {
            transform: none;
        }
        .author-modal {
            border: 0;
            border-radius: 10px;
            box-shadow: 0 18px 50px rgba(36, 19, 15, 0.24);
            color: var(--color-text);
            max-width: 420px;
            padding: 2rem;
            width: calc(100% - 2rem);
        }
        .author-modal::backdrop {
            background: rgba(36, 19, 15, 0.45);
        }
        .author-modal h2 {
            color: var(--color-primary);
            margin: 0;
        }
        .author-modal-heading {
            align-items: center;
            display: flex;
            gap: 1rem;
            margin-bottom: 0.75rem;
        }
        .author-modal-image {
            border-radius: 50%;
            flex: 0 0 72px;
            height: 72px;
            object-fit: cover;
            width: 72px;
        }
        .author-modal-close {
            background: var(--color-primary);
            border: 0;
            border-radius: 4px;
            color: var(--color-on-primary);
            cursor: pointer;
            margin-top: 1rem;
            padding: 0.6rem 1rem;
        }

        @media (max-width: 560px) {
            .meta-info {
                align-items: flex-start;
                flex-direction: column;
                gap: 0.35rem;
            }

            .meta-author {
                display: inline-flex;
                flex-wrap: nowrap;
                white-space: nowrap;
            }

            .meta-details {
                display: inline-flex;
                flex-wrap: nowrap;
                gap: 0.45rem;
                white-space: nowrap;
            }

            .meta-divider {
                display: none;
            }
        }
    </style>
 </Fragment>

    <div class="article-container">
        <!-- Datos ocultos para uso del script de memoria -->
        <div id="current-post-data" data-id={entry.id} data-title={entry.data.title} style="display:none;"></div>

        <article>
            <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Archivo', href: '/archivo/' }, { label: entry.data.title }]} />
            <header class="article-header">
                <h1>{entry.data.title}</h1>
                
                <div class="meta-info">
                    <span class="meta-author">
                        <button class="author-trigger" type="button" data-author-modal="author-modal" aria-label={`Ver biografía de ${entry.data.author}`} title={`Abrir biografía de ${entry.data.author}`}>
                            <img src={authorImage} alt={`Foto de ${entry.data.author}`} width="44" height="44" />
                        </button>
                        <span>Por <a href={`/autores/${entry.data.authorSlug ?? slugify(entry.data.author)}/`}><strong>{entry.data.author}</strong></a></span>
                        <button class="author-bio-trigger" type="button" data-author-modal="author-modal" aria-label={`Ver biografía de ${entry.data.author}`} title={`Abrir biografía de ${entry.data.author}`}>ver bio</button>
                    </span>
                    <span class="meta-details">
                        <time>{formatDate(entry.data.pubDate)}</time>
                        <span class="meta-divider" aria-hidden="true">•</span>
                        <span>{readingMinutes} min de lectura</span>
                    </span>
                </div>
                <span class="post-category-list">
                    {entry.data.category.map((category, index) => (
                        <span>
                            {index > 0 && <span aria-hidden="true"> / </span>}
                            <a class="post-category-item" href={`/categorias/${slugify(category)}/`}>{category}</a>
                        </span>
                    ))}
                </span>

                {entry.data.tags && entry.data.tags.length > 0 && (
                    <div class="tag-list">
                        {entry.data.tags.map(tag => (
                            <a href={`/tags/${slugify(tag)}/`} class="tag-item">
                                #{tag}
                            </a>
                        ))}
                    </div>
                )}

                {entry.data.image && entry.data.showImageInArticle && !hasInlineFeaturedImage && (
                    <figure class="featured-figure">
                        <img src={entry.data.image} alt={entry.data.title} class="featured-image" />
                        {featuredImageCaption && <figcaption>{featuredImageCaption}</figcaption>}
                    </figure>
                )}
            </header>

            <div class="article-layout">
                <TableOfContents headings={headings} />
                <div class="article-content">
                <Content />
                </div>
            </div>

            <div class="article-disclaimer">
                <button class="article-disclaimer-trigger" type="button" data-disclaimer-modal="disclaimer-modal">
                    Descargo de Responsabilidad
                </button>
            </div>

            <p class="article-comment-cta">
                <a href="#contacto">Comenta este artículo...</a>
            </p>

            <section class="rating-wrap" aria-label="Valoración del artículo">
                <div class="rating-head">
                    <h2 class="rating-title">¿Te resultó útil este artículo?</h2>
                    <span class="rating-summary" id="rating-summary">Tu valoración</span>
                </div>
                <div class="star-rating" role="radiogroup" aria-label="Califica este artículo">
                    {[1,2,3,4,5].map((star) => (
                        <button class="star-button" type="button" data-value={star} aria-label={`Calificar con ${star} estrellas`}>
                            ★
                        </button>
                    ))}
                </div>
                <p class="rating-note" id="rating-note">Tu valoración ayuda a identificar contenidos más útiles para la comunidad.</p>
            </section>

            <div class="article-post-share" id="post-share" aria-label="Compartir post"></div>
        </article>

        <dialog class="author-modal" id="author-modal">
            <div class="author-modal-heading">
                <img class="author-modal-image" src={authorImage} alt={`Foto de ${entry.data.author}`} width="72" height="72" />
                <h2>{entry.data.author}</h2>
            </div>
            <p>{authorBio}</p>
            <button class="author-modal-close" type="button">Cerrar</button>
        </dialog>

        <dialog class="disclaimer-modal" id="disclaimer-modal">
            <h2>Descargo de Responsabilidad</h2>
            <p>
                El contenido publicado en este artículo corresponde a la opinión personal del autor y no constituye, ni debe interpretarse como, una posición oficial, representativa o institucional de Cultura y Desarrollo. Cultura y Desarrollo no asume responsabilidad por los criterios, interpretaciones, juicios o afirmaciones formulados por el autor en el desarrollo de esta publicación.
            </p>
            <p style="margin-top: 0.9rem;">
                El autor es responsable de la veracidad, pertinencia, alcance y consecuencias jurídicas, éticas o reputacionales de lo expresado en este texto, así como de la información o análisis que aquí se presenta.
            </p>
            <button class="disclaimer-modal-close" type="button">Cerrar</button>
        </dialog>

        <!-- COMPONENTE: HISTORIAL ANTERIORMENTE CONSULTADO -->
        <div class="history-container" id="history-box">
            <a href="#" id="history-link" class="history-btn">
                <span class="label">↩️ Regresar al artículo consultado anteriormente</span>
                <span class="title" id="history-title">Cargando...</span>
            </a>
        </div>

        <!-- COMPONENTE: ANTERIOR / SIGUIENTE CRONOLÓGICO -->
        <nav class="pagination-container" aria-label="Navegación de artículos">
            {nextPost ? (
                <a href={`/${nextPost.id}/`} class="pagination-btn next">
                    <span class="label">← Más Antiguo</span>
                    <span class="title">{nextPost.data.title}</span>
                </a>
            ) : (
                <div style="flex: 1;"></div>
            )}

            {prevPost ? (
                <a href={`/${prevPost.id}/`} class="pagination-btn prev">
                    <span class="label">Más Reciente →</span>
                    <span class="title">{prevPost.data.title}</span>
                </a>
            ) : (
                <div style="flex: 1;"></div>
            )}
        </nav>

        <!-- RECOMENDACIONES -->
        {finalRelatedPosts.length > 0 && (
            <section class="related-section">
                <h2 style="color: var(--color-primary); font-size: 1.4rem; margin-bottom: 1rem;">Artículos relacionados</h2>
                <div class="related-grid">
                    {finalRelatedPosts.map(post => (
                        <div class="related-card">
                            <h3><a href={`/${post.id}/`}>{post.data.title}</a></h3>
                            <p>{post.data.description}</p>
                            <a href={`/${post.id}/`} style="font-size: 0.85rem; font-weight: 600;">Leer más →</a>
                        </div>
                    ))}
                </div>
            </section>
        )}

        <ContactForm
            postTitle={entry.data.title}
            postAuthor={entry.data.author}
            postDate={formatDate(entry.data.pubDate)}
        />
        <BackToTop />
    </div>

    {/* SCRIPT CON COMILLAS INVERTIDAS DE JAVASCRIPT */}
    <script is:inline>
        const articleId = document.getElementById('current-post-data')?.dataset.id || 'article';
        const ratingSummary = document.getElementById('rating-summary');
        const ratingNote = document.getElementById('rating-note');
        const contactContext = document.querySelector('input[name="article_context"]');
        const contactContextLabel = document.getElementById('contact-context');
        const contactRating = document.getElementById('contact-rating');
        const stars = Array.from(document.querySelectorAll('.star-button'));
        const storageKey = `ccd-rating-${articleId}`;

        const setContactRating = (value) => {
            const starsValue = `${'★'.repeat(value)}${'☆'.repeat(5 - value)} (${value}/5)`;
            if (contactRating) contactRating.value = starsValue;
            if (contactContext) contactContext.value = `${contactContext.dataset.base} · Valoración: ${starsValue}`;
            if (contactContextLabel) contactContextLabel.textContent = `${contactContextLabel.dataset.base} · Valoración: ${starsValue}`;
        };

        const setActiveStars = (value) => {
            stars.forEach((star) => {
                const starValue = Number(star.dataset.value);
                star.classList.toggle('is-active', starValue <= value);
                star.setAttribute('aria-pressed', String(starValue <= value));
            });
        };

        const savedRating = Number(window.localStorage.getItem(storageKey) || 0);
        if (savedRating > 0) {
            setActiveStars(savedRating);
            setContactRating(savedRating);
            if (ratingNote) ratingNote.textContent = `Gracias por valorar este artículo con ${savedRating} estrella${savedRating > 1 ? 's' : ''}.`;
        }

        stars.forEach((star) => {
            star.addEventListener('click', () => {
                const value = Number(star.dataset.value || 0);
                window.localStorage.setItem(storageKey, String(value));
                setActiveStars(value);
                setContactRating(value);
                if (ratingSummary) {
                    ratingSummary.textContent = `${value}/5 · gracias por tu valoración`;
                }
                if (ratingNote) {
                    ratingNote.textContent = `Gracias por valorar este artículo con ${value} estrella${value > 1 ? 's' : ''}.`;
                }
            });
        });

        const sharePageUrl = window.location.href;
        const sharePageTitle = document.title;

        const socialIconPaths = {
            whatsapp: '<path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L.2 24l6.5-1.7a11.8 11.8 0 0 0 5.4 1.3h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.1-1.2-6-3.5-8.3Zm-8.4 18.1h-.1c-1.7 0-3.4-.5-4.8-1.3l-.3-.2-3.9 1 1-3.8-.2-.3a9.8 9.8 0 0 1-1.5-5.2C2.3 6.4 6.7 2 12.1 2c2.6 0 5 1 6.9 2.9a9.7 9.7 0 0 1 2.9 6.9c0 5.4-4.4 9.8-9.8 9.8Zm5.4-7.3c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.2-.2.3-.7.9-.8 1.1-.2.2-.3.2-.6.1-.3-.2-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6-.1-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.3 3.2c.2.2 2.2 3.4 5.4 4.7.8.3 1.4.5 1.9.6.8.3 1.5.2 2 .1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.1-1.4-.2-.2-.4-.3-.7-.4Z"/>',
            linkedin: '<path d="M4.7 3.1A2.5 2.5 0 1 1-.3 3a2.5 2.5 0 0 1 5 0ZM0 8h4.7v15H0V8Zm7.7 0h4.5v2.1h.1c.6-1.2 2.2-2.5 4.6-2.5 4.9 0 5.8 3.2 5.8 7.4V23H18v-7.1c0-1.7 0-3.9-2.4-3.9s-2.8 1.9-2.8 3.8V23H8.1V8Z" transform="translate(0 0)"/>',
            facebook: '<path d="M13.5 23v-9h3l.5-3.5h-3.5V8.2c0-1 .3-1.7 1.8-1.7h1.9V3.4c-.3 0-1.5-.1-2.8-.1-2.8 0-4.7 1.7-4.7 4.8v2.4H6.5V14h3.2v9h3.8Z"/>',
            x: '<path d="M18.9 2h3.7l-8.1 9.3L24 22h-7.5l-5.9-7.7L3.9 22H.2l8.7-10L0 2h7.7l5.3 7L18.9 2Zm-1.3 17.9h2L6.4 4H4.2l13.4 15.9Z"/>',
            telegram: '<path d="m23.8 2.4-3.6 19.1c-.3 1.4-1.1 1.7-2.2 1.1l-6.1-4.5-2.9 2.8c-.3.3-.5.5-1 .5l.4-6.2L19.7 5c.5-.4-.1-.6-.7-.2L5.5 13.3l-5.8-1.8c-1.3-.4-1.3-1.3.3-1.9L22.6.8c1.1-.4 2 .3 1.2 1.6Z"/>',
                tiktok: '<path d="M15.5 2h3.2c.2 1.8 1.3 3.4 3 4.3v3.3a8.6 8.6 0 0 1-3-.8v6.8a6.4 6.4 0 1 1-5.5-6.3v3.4a3.1 3.1 0 1 0 2.3 3V2Z"/>',
            instagram: '<path fill-rule="evenodd" d="M7 1h10a6 6 0 0 1 6 6v10a6 6 0 0 1-6 6H7a6 6 0 0 1-6-6V7a6 6 0 0 1 6-6Zm0 2a4 4 0 0 0-4 4v10a4 4 0 0 0 4 4h10a4 4 0 0 0 4-4V7a4 4 0 0 0-4-4H7Zm5 3.5A5.5 5.5 0 1 1 6.5 12 5.5 5.5 0 0 1 12 6.5Zm0 2A3.5 3.5 0 1 0 15.5 12 3.5 3.5 0 0 0 12 8.5ZM18.2 5.3a1.3 1.3 0 1 1-1.3 1.3 1.3 1.3 0 0 1 1.3-1.3Z"/>',
            more: '<path d="M5 10.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm7 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm7 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z"/>',
            download: '<path d="M11 2h2v11.2l3.6-3.6 1.4 1.4-6 6-6-6 1.4-1.4 3.6 3.6V2Zm-7 18h14v2H4v-2Z"/>'
        };

        const createIcon = (name) => {
            const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            icon.setAttribute('viewBox', '0 0 24 24');
            icon.setAttribute('aria-hidden', 'true');
            icon.innerHTML = socialIconPaths[name];
            return icon;
        };

        const createShareLink = (label, iconName, href, extraAttributes = {}) => {
            const link = document.createElement('a');
            link.append(createIcon(iconName));
            link.href = href;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.title = label;
            link.setAttribute('aria-label', label);
            Object.entries(extraAttributes).forEach(([name, value]) => link.setAttribute(name, value));
            return link;
        };

        const copyPostAndOpenSocial = async (platform, url) => {
            let copied = false;
            try {
                await navigator.clipboard.writeText(sharePageUrl);
                copied = true;
            } catch {
            }
            window.open(url, '_blank', 'noopener,noreferrer');
            statusElement.textContent = copied
                ? `Enlace copiado. Pégalo en ${platform} para publicar.`
                : `Abre ${platform} y pega manualmente el enlace del post.`;
        };

        const sharePostWithDevice = async (statusElement) => {
            if (navigator.share) {
                try {
                    await navigator.share({ title: sharePageTitle, text: sharePageTitle, url: sharePageUrl });
                    statusElement.textContent = 'Post compartido.';
                } catch (error) {
                    if (error.name !== 'AbortError') statusElement.textContent = 'No fue posible compartir el post.';
                }
                return;
            }
            try {
                await navigator.clipboard.writeText(sharePageUrl);
                statusElement.textContent = 'Enlace del post copiado.';
            } catch {
                statusElement.textContent = 'Copia la dirección del post para compartirlo.';
            }
        };

        const postShare = document.getElementById('post-share');
        if (postShare) {
            const encodedText = encodeURIComponent(`${sharePageTitle} ${sharePageUrl}`);
            const encodedUrl = encodeURIComponent(sharePageUrl);
            const shareLabel = document.createElement('p');
            shareLabel.className = 'article-post-share-label';
            shareLabel.textContent = 'Comparta este post';
            const statusElement = document.createElement('span');
            statusElement.className = 'article-post-share-status';
            statusElement.setAttribute('role', 'status');

            const createCopyAndOpenButton = (label, iconName, platform, url) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.append(createIcon(iconName));
                button.title = `${label} (copiar enlace)`;
                button.setAttribute('aria-label', `${label}: copiar enlace y abrir`);
                button.addEventListener('click', () => copyPostAndOpenSocial(platform, url));
                return button;
            };

            const moreButton = document.createElement('button');
            moreButton.type = 'button';
            moreButton.append(createIcon('more'));
            moreButton.title = 'Copiar enlace';
            moreButton.setAttribute('aria-label', 'Copiar enlace del post');
            moreButton.addEventListener('click', () => sharePostWithDevice(statusElement));

            postShare.append(
                shareLabel,
                createShareLink('LinkedIn', 'linkedin', `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`),
                createCopyAndOpenButton('Instagram', 'instagram', 'Instagram', 'https://www.instagram.com/'),
                createCopyAndOpenButton('TikTok', 'tiktok', 'TikTok', 'https://www.tiktok.com/'),
                createShareLink('Telegram', 'telegram', `https://t.me/share/url?url=${encodedUrl}&text=${encodeURIComponent(sharePageTitle)}`),
                createShareLink('WhatsApp', 'whatsapp', `https://wa.me/?text=${encodedText}`),
                createShareLink('Facebook', 'facebook', `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`),
                createShareLink('X', 'x', `https://twitter.com/intent/tweet?text=${encodeURIComponent(sharePageTitle)}&url=${encodedUrl}`),
                moreButton,
                statusElement
            );
        }

        const authorTrigger = document.querySelector('[data-author-modal]');
        const authorModal = document.getElementById('author-modal');
        const authorModalClose = authorModal?.querySelector('.author-modal-close');
        authorTrigger?.addEventListener('click', () => authorModal?.showModal());
        authorModalClose?.addEventListener('click', () => authorModal?.close());
        authorModal?.addEventListener('click', (event) => {
            if (event.target === authorModal) authorModal.close();
        });

        const disclaimerTrigger = document.querySelector('[data-disclaimer-modal]');
        const disclaimerModal = document.getElementById('disclaimer-modal');
        const disclaimerModalClose = disclaimerModal?.querySelector('.disclaimer-modal-close');
        disclaimerTrigger?.addEventListener('click', () => disclaimerModal?.showModal());
        disclaimerModalClose?.addEventListener('click', () => disclaimerModal?.close());
        disclaimerModal?.addEventListener('click', (event) => {
            if (event.target === disclaimerModal) disclaimerModal.close();
        });

        document.addEventListener('DOMContentLoaded', () => {
            const currentEl = document.getElementById('current-post-data');
            if (!currentEl) return;
            
            const currentId = currentEl.getAttribute('data-id');
            const currentTitle = currentEl.getAttribute('data-title');
            const previousPost = JSON.parse(localStorage.getItem('last_visited_post'));

            if (previousPost && previousPost.id !== currentId) {
                const historyBox = document.getElementById('history-box');
                const historyLink = document.getElementById('history-link');
                const historyTitle = document.getElementById('history-title');

                if (historyBox && historyLink && historyTitle) {
                   historyTitle.innerText = previousPost.title;
                   historyLink.href = `/${previousPost.id}/`;
                   historyBox.style.display = 'block';
                }
             }
            
            localStorage.setItem('last_visited_post', JSON.stringify({
                id: currentId,
                title: currentTitle
            }));
        });
    </script>

</Layout>

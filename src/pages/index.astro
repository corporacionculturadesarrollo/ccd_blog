---
import { getCollection } from 'astro:content';
import ContactForm from '../components/ContactForm.astro';
import BackToTop from '../components/BackToTop.astro';
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../lib/formatDate';
import { slugify } from '../lib/slugify';
import { HOME_PAGE_SIZE } from '../lib/pagination';
import { getPostImage } from '../lib/postImage';
import { resolveAuthor, resolveAuthorImage } from '../lib/author';

// 1. Force Astro to fetch all entries inside the src/content/blog/ folder
const posts = await getCollection('blog');
const authors = await getCollection('autores');
const getAuthorBio = (post: (typeof posts)[number]) =>
  resolveAuthor(authors, post.data.authorSlug, post.data.author)?.body ||
  post.data.authorBio ||
  'Biografía del autor próximamente.';

const getAuthorImage = (post: (typeof posts)[number]) =>
  resolveAuthorImage(authors, {
    authorSlug: post.data.authorSlug,
    author: post.data.author,
    authorImage: post.data.authorImage,
  });

const getReadingMinutes = (body?: string) => Math.max(1, Math.ceil((body?.split(/\s+/).filter(Boolean).length ?? 0) / 200));

const getPostSortTimestamp = (post: (typeof posts)[number]) => {
  const createdAt = post.data.createdAt ? new Date(post.data.createdAt).getTime() : null;
  return createdAt ?? new Date(post.data.pubDate).getTime();
};

// 2. Sort the articles by the blog-entry date, with pubDate as fallback
const sortedPosts = posts
  .map((post) => ({
    ...post,
    data: {
      ...post.data,
      image: getPostImage(post),
    },
    readingMinutes: getReadingMinutes(post.body),
    searchText: [
      post.data.title,
      post.data.description,
      post.data.category.join(' '),
      post.data.tags.join(' '),
      post.body || '',
    ]
      .join(' ')
      .toLowerCase()
      .replace(/[#[\]()*_`~]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim(),
  }))
  .sort((a, b) => getPostSortTimestamp(b) - getPostSortTimestamp(a));

const pagePosts = sortedPosts.slice(0, HOME_PAGE_SIZE);
const authorList = [...new Set(sortedPosts.map((post) => post.data.author))].sort((a, b) => a.localeCompare(b));
const latestPost = pagePosts[0] ?? null;
const featuredPosts = pagePosts.filter((post) => post.data.featured && post.id !== latestPost?.id).slice(0, 3);
const regularPosts = pagePosts.filter((post) => {
  if (post.id === latestPost?.id) return false;
  if (!post.data.featured) return true;
  return !featuredPosts.some((featuredPost) => featuredPost.id === post.id);
});
const pageCount = Math.ceil(sortedPosts.length / HOME_PAGE_SIZE);
---

<Layout
    title="Blog | Cultura y Desarrollo"
    description="Espacio de difusión, análisis y gestión cultural comunitaria."
>
    <div class="blog-container">
        <header class="blog-header">
            <img
                src="/images/banner.webp"
                alt="Blog de Cultura y Desarrollo"
                class="home-banner"
                width="2200"
                height="1080"
                fetchpriority="high"
                decoding="async"
            />
        </header>

        <div class="blog-search-wrap" aria-label="Buscar artículos del blog">
            <form id="blog-search-form" class="blog-search-controls" role="search" aria-label="Buscar artículos" data-index-url={`${import.meta.env.BASE_URL}search-index.json`} data-base-url={import.meta.env.BASE_URL}>
                <input
                    id="blog-search-input"
                    class="blog-search-input"
                    type="search"
                    placeholder="Título, tema o contenido..."
                    autocomplete="off"
                    enterkeyhint="search"
                    aria-controls="blog-empty-state blog-search-count"
                />
                <select id="blog-author-filter" class="blog-author-filter" aria-label="Filtrar por autor">
                    <option value="">Todos los autores</option>
                    {authorList.map((author) => (
                        <option value={author}>{author}</option>
                    ))}
                </select>
            </form>
            <p id="blog-search-count" class="blog-search-count" aria-live="polite">
                {sortedPosts.length} artículo{sortedPosts.length === 1 ? '' : 's'} · página 1 de {pageCount}
            </p>
            <div id="global-search-results" class="global-search-results" hidden aria-live="polite"></div>
        </div>

        <main>
            {sortedPosts.length === 0 ? (
                <div style="padding: 2rem; background: var(--color-bg-alt); border-radius: 8px; text-align: center;">
                    <p style="margin: 0; color: #667085;">No se encontraron artículos en la carpeta src/content/blog/</p>
                </div>
            ) : (
                <>
                    {latestPost && (
                        <section class="featured-section latest-section" aria-labelledby="latest-heading">
                            <div class="featured-header">
                                <h2 id="latest-heading">Artículo reciente</h2>
                            </div>
                            <div class="featured-grid">
                                <article class="featured-card latest-card" data-search={latestPost.searchText} data-author={latestPost.data.author}>
                                    {latestPost.data.image && (
                                        <img class="latest-card-image" src={latestPost.data.image} alt={`Imagen destacada de ${latestPost.data.title}`} loading="lazy" decoding="async" />
                                    )}
                                    <div class="latest-card-content">
                                        <h3>
                                            <a href={`/${latestPost.id}/`}>{latestPost.data.title}</a>
                                        </h3>
                                        <div class="featured-meta">
                                            <span class="featured-author-line">
                                                <button class="author-trigger" type="button" data-author-modal={`author-modal-${latestPost.id}`} aria-label={`Ver biografía de ${latestPost.data.author}`} title={`Abrir biografía de ${latestPost.data.author}`}>
                                                    <img class="post-author-avatar" src={getAuthorImage(latestPost)} alt={`Foto de ${latestPost.data.author}`} width="28" height="28" loading="lazy" decoding="async" />
                                                </button>
                                                <span>Por {latestPost.data.author}</span>
                                                <button class="author-bio-trigger" type="button" data-author-modal={`author-modal-${latestPost.id}`} aria-label={`Ver biografía de ${latestPost.data.author}`} title={`Abrir biografía de ${latestPost.data.author}`}>ver bio</button>
                                            </span>
                                            <time class="post-date" datetime={latestPost.data.pubDate.toISOString()}>{formatDate(latestPost.data.pubDate)} · {latestPost.readingMinutes} min de lectura</time>
                                        </div>
                                        <span class="post-category-list">
                                            {latestPost.data.category.map((category, index) => (
                                                <span>
                                                    {index > 0 && <span aria-hidden="true"> / </span>}
                                                    <a class="post-category-item" href={`/categorias/${slugify(category)}/`}>{category}</a>
                                                </span>
                                            ))}
                                        </span>
                                        <p>{latestPost.data.description}</p>
                                        <a href={`/${latestPost.id}/`} class="read-more">Leer artículo →</a>
                                        <dialog class="author-modal" id={`author-modal-${latestPost.id}`}>
                                            <div class="author-modal-heading">
                                                <img class="author-modal-image" src={getAuthorImage(latestPost)} alt={`Foto de ${latestPost.data.author}`} width="72" height="72" loading="lazy" decoding="async" />
                                                <h2>{latestPost.data.author}</h2>
                                            </div>
                                            <p>{getAuthorBio(latestPost)}</p>
                                            <button class="author-modal-close" type="button">Cerrar</button>
                                        </dialog>
                                    </div>
                                </article>
                            </div>
                        </section>
                    )}

                    {featuredPosts.length > 0 && (
                        <section class="featured-section" aria-labelledby="featured-heading">
                            <div class="featured-header">
                                <h2 id="featured-heading">Artículos destacados</h2>
                                <p>Temas estratégicos, convocatorias y contenidos de mayor relevancia editorial.</p>
                            </div>
                            <div class="featured-grid">
                                {featuredPosts.map((post, index) => (
                                    <article class:list={['featured-card', { 'featured-card-compact': index === 0 }]} data-search={post.searchText} data-author={post.data.author}>
                                        {post.data.image && (
                                            <img class="featured-card-image" src={post.data.image} alt={`Imagen destacada de ${post.data.title}`} loading="lazy" decoding="async" />
                                        )}
                                        <span class="featured-badge">Destacado</span>
                                        <h3>
                                            <a href={`/${post.id}/`}>{post.data.title}</a>
                                        </h3>
                                        <div class="featured-meta">
                                            <span class="featured-author-line">
                                                <button class="author-trigger" type="button" data-author-modal={`author-modal-${post.id}`} aria-label={`Ver biografía de ${post.data.author}`} title={`Abrir biografía de ${post.data.author}`}>
                                                    <img class="post-author-avatar" src={getAuthorImage(post)} alt={`Foto de ${post.data.author}`} width="28" height="28" loading="lazy" decoding="async" />
                                                </button>
                                                <span>Por {post.data.author}</span>
                                                    <button class="author-bio-trigger" type="button" data-author-modal={`author-modal-${post.id}`} aria-label={`Ver biografía de ${post.data.author}`} title={`Abrir biografía de ${post.data.author}`}>ver bio</button>
                                            </span>
                                            <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)} · {post.readingMinutes} min de lectura</time>
                                        </div>
                                        <span class="post-category-list">
                                            {post.data.category.map((category, index) => (
                                                <span>
                                                    {index > 0 && <span aria-hidden="true"> / </span>}
                                                    <a class="post-category-item" href={`/categorias/${slugify(category)}/`}>{category}</a>
                                                </span>
                                            ))}
                                        </span>
                                        <p>{post.data.description}</p>
                                        <a href={`/${post.id}/`} class="read-more">Leer artículo →</a>
                                        <dialog class="author-modal" id={`author-modal-${post.id}`}>
                                            <div class="author-modal-heading">
                                                <img class="author-modal-image" src={getAuthorImage(post)} alt={`Foto de ${post.data.author}`} width="72" height="72" loading="lazy" decoding="async" />
                                                <h2>{post.data.author}</h2>
                                            </div>
                                            <p>{getAuthorBio(post)}</p>
                                            <button class="author-modal-close" type="button">Cerrar</button>
                                        </dialog>
                                    </article>
                                ))}
                            </div>
                        </section>
                    )}

                    <div id="blog-empty-state" class="blog-empty-state" hidden>
                        <p>No se encontraron artículos que coincidan con tu búsqueda.</p>
                    </div>
                    {regularPosts.length > 0 && (
                        <section class="older-posts-section" aria-labelledby="older-posts-heading">
                            <div class="featured-header">
                                <h2 id="older-posts-heading">Artículos anteriores</h2>
                            </div>
                            <ul class="posts-list">
                                {regularPosts.map((post, index) => (
                                    <li class:list={['post-item', { 'post-item-with-image': index === 0 && post.data.image }]} data-search={post.searchText} data-author={post.data.author}>
                                {post.data.image && (
                                    <img class="older-post-image" src={post.data.image} alt={`Imagen destacada de ${post.data.title}`} loading="lazy" decoding="async" />
                                )}
                                <div class="older-post-content">
                                <h2>
                                    <a class="post-title-link" href={`/${post.id}/`}>{post.data.title}</a>
                                </h2>
                                <div class="post-meta-inline">
                                    <span class="post-author-line">
                                        <button class="author-trigger" type="button" data-author-modal={`author-modal-${post.id}`} aria-label={`Ver biografía de ${post.data.author}`} title={`Abrir biografía de ${post.data.author}`}>
                                            <img class="post-author-avatar" src={getAuthorImage(post)} alt={`Foto de ${post.data.author}`} width="28" height="28" loading="lazy" decoding="async" />
                                        </button>
                                        <span>Por {post.data.author}</span>
                                        <button class="author-bio-trigger" type="button" data-author-modal={`author-modal-${post.id}`} aria-label={`Ver biografía de ${post.data.author}`} title={`Abrir biografía de ${post.data.author}`}>ver bio</button>
                                    </span>
                                    <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)} · {post.readingMinutes} min de lectura</time>
                                </div>
                                <span class="post-category-list">
                                    {post.data.category.map((category, index) => (
                                        <span>
                                            {index > 0 && <span aria-hidden="true"> / </span>}
                                            <a class="post-category-item" href={`/categorias/${slugify(category)}/`}>{category}</a>
                                        </span>
                                    ))}
                                </span>
                                
                                <p class="post-description">{post.data.description}</p>
                                
                                <a class="read-more" href={`/${post.id}/`}>Leer artículo →</a>
                                <dialog class="author-modal" id={`author-modal-${post.id}`}>
                                    <div class="author-modal-heading">
                                        <img class="author-modal-image" src={getAuthorImage(post)} alt={`Foto de ${post.data.author}`} width="72" height="72" loading="lazy" decoding="async" />
                                        <h2>{post.data.author}</h2>
                                    </div>
                                    <p>{getAuthorBio(post)}</p>
                                    <button class="author-modal-close" type="button">Cerrar</button>
                                </dialog>
                                </div>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )}
                    {pageCount > 1 && (
                        <nav class="pagination-container archive-pagination" aria-label="Paginación de artículos">
                            <span aria-hidden="true"></span>
                            <a class="pagination-btn next" href="/pagina/2/">
                                <span class="label">Más antiguos →</span>
                                <span class="title">Página 2</span>
                            </a>
                        </nav>
                    )}
                </>
            )}
        </main>
        <ContactForm postTitle="Consulta general del blog" />
        <BackToTop />
    </div>
    <script is:inline>
        const searchInput = document.getElementById('blog-search-input');
        const authorFilter = document.getElementById('blog-author-filter');
        const searchForm = document.getElementById('blog-search-form');
        const posts = Array.from(document.querySelectorAll('.post-item, .featured-card'));
        const emptyState = document.getElementById('blog-empty-state');
        const countEl = document.getElementById('blog-search-count');
        const globalResults = document.getElementById('global-search-results');
        const searchIndexUrl = searchForm?.dataset.indexUrl || '/search-index.json';
        const siteBaseUrl = searchForm?.dataset.baseUrl || '/';
        let globalIndex = null;

        const loadGlobalIndex = async () => {
            if (globalIndex) return globalIndex;
            const response = await fetch(searchIndexUrl);
            if (!response.ok) throw new Error('No se pudo cargar el índice de búsqueda.');
            globalIndex = (await response.json()).items || [];
            return globalIndex;
        };

        const renderGlobalResults = (query) => {
            if (!globalResults) return;
            const matches = globalIndex.filter((item) => item.text.toLowerCase().includes(query));
            globalResults.replaceChildren();
            if (!query || matches.length === 0) {
                globalResults.hidden = true;
                return;
            }
            const heading = document.createElement('strong');
            heading.textContent = `Resultados en todo el archivo (${matches.length})`;
            globalResults.append(heading);
            const list = document.createElement('ul');
            matches.slice(0, 8).forEach((item) => {
                const li = document.createElement('li');
                const link = document.createElement('a');
                link.href = `${siteBaseUrl.replace(/\/$/, '')}${item.url}`;
                link.textContent = item.title;
                li.append(link);
                list.append(li);
            });
            globalResults.append(list);
            globalResults.hidden = false;
        };

        const applyFilters = () => {
            const query = (searchInput?.value || '').trim().toLowerCase();
            const selectedAuthor = authorFilter?.value || '';
            let visibleCount = 0;

            posts.forEach((post) => {
                const haystack = (post.dataset.search || post.textContent || '').toLowerCase();
                const matchesQuery = !query || haystack.includes(query);
                const matchesAuthor = !selectedAuthor || (post.dataset.author || '') === selectedAuthor;
                const match = matchesQuery && matchesAuthor;
                post.hidden = !match;
                if (match) visibleCount += 1;
            });

            document.querySelectorAll('.featured-section').forEach((section) => {
                section.hidden = !section.querySelector('.featured-card:not([hidden])');
            });

            if (emptyState) emptyState.hidden = visibleCount !== 0;
            if (countEl) {
                const label = visibleCount === 1 ? 'artículo' : 'artículos';
                const baseLabel = `${posts.length} ${label}`;
                countEl.textContent = query || selectedAuthor ? `${visibleCount} ${label} coincidentes` : baseLabel;
            }
            if (query) loadGlobalIndex().then(() => renderGlobalResults(query)).catch(() => {});
            else if (globalResults) globalResults.hidden = true;
        };

        searchInput?.addEventListener('input', applyFilters);
        authorFilter?.addEventListener('change', applyFilters);
        searchForm?.addEventListener('submit', (event) => {
            event.preventDefault();
            applyFilters();
        });

        document.querySelectorAll('[data-author-modal]').forEach((trigger) => {
            const modal = document.getElementById(trigger.dataset.authorModal);
            const closeButton = modal?.querySelector('.author-modal-close');
            if (!modal || !closeButton) return;

            trigger.addEventListener('click', () => modal.showModal());
            closeButton.addEventListener('click', () => modal.close());
            modal.addEventListener('click', (event) => {
                if (event.target === modal) modal.close();
            });
        });
    </script>
</Layout>

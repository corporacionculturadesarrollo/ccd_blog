---
import { getCollection } from 'astro:content';
import ContactForm from '../components/ContactForm.astro';
import BackToTop from '../components/BackToTop.astro';
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../lib/formatDate';
import { slugify } from '../lib/slugify';
import { HOME_PAGE_SIZE } from '../lib/pagination';
import { getPostImage } from '../lib/postImage';
import { resolveAuthor, resolveAuthorImage } from '../lib/author';

// 1. Force Astro to fetch all entries inside the src/content/blog/ folder
const posts = await getCollection('blog');
const authors = await getCollection('autores');
const getAuthorBio = (post: (typeof posts)[number]) =>
  resolveAuthor(authors, post.data.authorSlug, post.data.author)?.body ||
  post.data.authorBio ||
  'Biografía del autor próximamente.';

const getAuthorImage = (post: (typeof posts)[number]) =>
  resolveAuthorImage(authors, {
    authorSlug: post.data.authorSlug,
    author: post.data.author,
    authorImage: post.data.authorImage,
  });

const getReadingMinutes = (body?: string) => Math.max(1, Math.ceil((body?.split(/\s+/).filter(Boolean).length ?? 0) / 200));

const getPostSortTimestamp = (post: (typeof posts)[number]) => {
  const createdAt = post.data.createdAt ? new Date(post.data.createdAt).getTime() : null;
  return createdAt ?? new Date(post.data.pubDate).getTime();
};

// 2. Sort the articles by the blog-entry date, with pubDate as fallback
const sortedPosts = posts
  .map((post) => ({
    ...post,
    data: {
      ...post.data,
      image: getPostImage(post),
    },
    readingMinutes: getReadingMinutes(post.body),
    searchText: [
      post.data.title,
      post.data.description,
      post.data.category.join(' '),
      post.data.tags.join(' '),
      post.body || '',
    ]
      .join(' ')
      .toLowerCase()
      .replace(/[#[\]()*_`~]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim(),
  }))
  .sort((a, b) => getPostSortTimestamp(b) - getPostSortTimestamp(a));

// Divide un arreglo en bloques para los carruseles (2 tarjetas por bloque)
function enBloques<T>(arr: T[], size = 2): T[][] {
  const out: T[][] = [];
  for (let i = 0; i < arr.length; i += size) out.push(arr.slice(i, i + size));
  return out;
}

const authorList = [...new Set(sortedPosts.map((post) => post.data.author))].sort((a, b) => a.localeCompare(b));
const latestPost = sortedPosts[0] ?? null;
// Destacados: todos los marcados como featured (aunque estén más allá de la primera página)
const featuredPosts = sortedPosts.filter((post) => post.data.featured && post.id !== latestPost?.id);
// Anteriores: lista completa de todo lo anterior al artículo reciente (los destacados se repiten)
const regularPosts = sortedPosts.filter((post) => post.id !== latestPost?.id);
const bloquesDestacados = enBloques(featuredPosts);
const bloquesAnteriores = enBloques(regularPosts);
const pageCount = Math.ceil(sortedPosts.length / HOME_PAGE_SIZE);
---

<Layout
    title="Blog | Cultura y Desarrollo"
    description="Espacio de difusión, análisis y gestión cultural comunitaria."
>
    <div class="blog-container">
        <header class="blog-header">
            <img
                src="/images/banner.webp"
                alt="Blog de Cultura y Desarrollo"
                class="home-banner"
                width="2200"
                height="1080"
                fetchpriority="high"
                decoding="async"
            />
        </header>

        <div class="blog-search-wrap" aria-label="Buscar artículos del blog">
            <form id="blog-search-form" class="blog-search-controls" role="search" aria-label="Buscar artículos" data-index-url={`${import.meta.env.BASE_URL}search-index.json`} data-base-url={import.meta.env.BASE_URL}>
                <input
                    id="blog-search-input"
                    class="blog-search-input"
                    type="search"
                    placeholder="Título, tema o contenido..."
                    autocomplete="off"
                    enterkeyhint="search"
                    aria-controls="blog-empty-state blog-search-count"
                />
                <select id="blog-author-filter" class="blog-author-filter" aria-label="Filtrar por autor">
                    <option value="">Todos los autores</option>
                    {authorList.map((author) => (
                        <option value={author}>{author}</option>
                    ))}
                </select>
            </form>
            <p id="blog-search-count" class="blog-search-count" aria-live="polite">
                {sortedPosts.length} artículo{sortedPosts.length === 1 ? '' : 's'} · página 1 de {pageCount}
            </p>
            <div id="global-search-results" class="global-search-results" hidden aria-live="polite"></div>
        </div>

        <main>
            {sortedPosts.length === 0 ? (
                <div style="padding: 2rem; background: var(--color-bg-alt); border-radius: 8px; text-align: center;">
                    <p style="margin: 0; color: #667085;">No se encontraron artículos en la carpeta src/content/blog/</p>
                </div>
            ) : (
                <>
                    {latestPost && (
                        <section class="featured-section latest-section" aria-labelledby="latest-heading">
                            <div class="featured-header">
                                <h2 id="latest-heading">Artículo reciente</h2>
                            </div>
                            <div class="featured-grid">
                                <article class="featured-card latest-card" data-search={latestPost.searchText} data-author={latestPost.data.author} data-post-id={latestPost.id}>
                                    <div class="latest-card-header">
                                        <span class="featured-badge">Reciente</span>
                                        <h3>
                                            <a href={`/${latestPost.id}/`}>{latestPost.data.title}</a>
                                        </h3>
                                        <div class="featured-meta">
                                            <span class="featured-author-line">
                                                <button class="author-trigger" type="button" aria-label={`Ver biografía de ${latestPost.data.author}`} title={`Abrir biografía de ${latestPost.data.author}`}>
                                                    <img class="post-author-avatar" src={getAuthorImage(latestPost)} alt={`Foto de ${latestPost.data.author}`} width="28" height="28" loading="lazy" decoding="async" />
                                                </button>
                                                <span>Por {latestPost.data.author}</span>
                                                <button class="author-bio-trigger" type="button" data-author-modal={`author-modal-${latestPost.id}`} aria-label={`Ver biografía de ${latestPost.data.author}`} title={`Abrir biografía de ${latestPost.data.author}`}>ver bio</button>
                                            </span>
                                            <time class="post-date" datetime={latestPost.data.pubDate.toISOString()}>{formatDate(latestPost.data.pubDate)} · {latestPost.readingMinutes} min de lectura</time>
                                        </div>
                                    </div>
                                    <div class="latest-card-body">
                                        {latestPost.data.image && (
                                            <img class="latest-card-image" src={latestPost.data.image} alt={`Imagen destacada de ${latestPost.data.title}`} loading="lazy" decoding="async" />
                                        )}
                                        <div class="latest-card-content">
                                            <span class="post-category-list">
                                                {latestPost.data.category.map((category, index) => (
                                                    <span>
                                                        {index > 0 && <span aria-hidden="true"> / </span>}
                                                        <a class="post-category-item" href={`/categorias/${slugify(category)}/`}>{category}</a>
                                                    </span>
                                                ))}
                                            </span>
                                            <p>{latestPost.data.description}</p>
                                            <a href={`/${latestPost.id}/`} class="read-more">Leer artículo →</a>
                                        </div>
                                    </div>
                                    <div class="author-modal" id={`author-modal-${latestPost.id}`} hidden aria-hidden="true" role="dialog" aria-modal="true">
                                        <div class="author-modal-heading">
                                            <img class="author-modal-image" src={getAuthorImage(latestPost)} alt={`Foto de ${latestPost.data.author}`} width="72" height="72" loading="lazy" decoding="async" />
                                            <h2>{latestPost.data.author}</h2>
                                        </div>
                                        <p>{getAuthorBio(latestPost)}</p>
                                        <button class="author-modal-close" type="button">Cerrar</button>
                                    </div>
                                </article>
                            </div>
                        </section>
                    )}

                    {featuredPosts.length > 0 && (
                        <section class="featured-section older-posts-section" aria-labelledby="featured-heading">
                            <div class="featured-header">
                                <h2 id="featured-heading">Artículos destacados</h2>
                                <p>Temas estratégicos, convocatorias y contenidos de mayor relevancia editorial.</p>
                                <p class="carousel-hint">Desliza o usa las flechas para ver más artículos</p>
                                {bloquesDestacados.length > 1 && (
                                    <div class="carousel-nav">
                                        <button class="carousel-btn prev" type="button" title="Bloque anterior" aria-label="Artículos destacados: bloque anterior"><span aria-hidden="true">‹</span></button>
                                        <div class="carousel-dots" aria-label="Artículos destacados: bloques">
                                            {bloquesDestacados.map((_, i) => (
                                                <button class="carousel-dot" type="button" aria-label={`Artículos destacados: ir al bloque ${i + 1}`} aria-current={i === 0}></button>
                                            ))}
                                        </div>
                                        <button class="carousel-btn next" type="button" title="Bloque siguiente" aria-label="Artículos destacados: bloque siguiente"><span aria-hidden="true">›</span></button>
                                    </div>
                                )}
                            </div>
                            <div class="carousel" role="region" aria-label="Artículos destacados, carrusel" tabindex="0">
                                <div class="carousel-track">
                                    {bloquesDestacados.map((bloque) => (
                                    <div class="carousel-slide">
                                    <ul class="posts-list">
                                {bloque.map((post) => (
                                    <li class:list={['post-item', { 'post-item-with-image': Boolean(post.data.image) }]} data-search={post.searchText} data-author={post.data.author} data-post-id={post.id}>
                                <div class="older-post-content">
                                {post.data.featured && <span class="featured-badge">Destacado</span>}
                                <h2>
                                    <a class="post-title-link" href={`/${post.id}/`}>{post.data.title}</a>
                                </h2>
                                <div class="post-meta-inline">
                                    <span class="post-author-line">
                                        <button class="author-trigger" type="button" aria-label={`Ver biografía de ${post.data.author}`} title={`Abrir biografía de ${post.data.author}`}>
                                            <img class="post-author-avatar" src={getAuthorImage(post)} alt={`Foto de ${post.data.author}`} width="28" height="28" loading="lazy" decoding="async" />
                                        </button>
                                        <span>Por {post.data.author}</span>
                                        <button class="author-bio-trigger" type="button" data-author-modal={`author-modal-${post.id}`} aria-label={`Ver biografía de ${post.data.author}`} title={`Abrir biografía de ${post.data.author}`}>ver bio</button>
                                    </span>
                                    <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)} · {post.readingMinutes} min de lectura</time>
                                </div>
                                <span class="post-category-list">
                                    {post.data.category.map((category, categoryIndex) => (
                                        <span>
                                            {categoryIndex > 0 && <span aria-hidden="true"> / </span>}
                                            <a class="post-category-item" href={`/categorias/${slugify(category)}/`}>{category}</a>
                                        </span>
                                    ))}
                                </span>
                                {post.data.image && (
                                    <img class="older-post-image" src={post.data.image} alt={`Imagen destacada de ${post.data.title}`} loading="lazy" decoding="async" />
                                )}
                                <p class="post-description">{post.data.description}</p>
                                
                                <a class="read-more" href={`/${post.id}/`}>Leer artículo →</a>
                                </div>
                                    </li>
                                ))}
                                            </ul>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </section>
                    )}

                    <div id="blog-empty-state" class="blog-empty-state" hidden>
                        <p>No se encontraron artículos que coincidan con tu búsqueda.</p>
                    </div>
                    {regularPosts.length > 0 && (
                        <section class="older-posts-section" aria-labelledby="older-posts-heading">
                            <div class="featured-header">
                                <h2 id="older-posts-heading">Artículos anteriores</h2>
                                <p class="carousel-hint">Desliza o usa las flechas para ver más artículos</p>
                                {bloquesAnteriores.length > 1 && (
                                    <div class="carousel-nav">
                                        <button class="carousel-btn prev" type="button" title="Bloque anterior" aria-label="Artículos anteriores: bloque anterior"><span aria-hidden="true">‹</span></button>
                                        <div class="carousel-dots" aria-label="Artículos anteriores: bloques">
                                            {bloquesAnteriores.map((_, i) => (
                                                <button class="carousel-dot" type="button" aria-label={`Artículos anteriores: ir al bloque ${i + 1}`} aria-current={i === 0}></button>
                                            ))}
                                        </div>
                                        <button class="carousel-btn next" type="button" title="Bloque siguiente" aria-label="Artículos anteriores: bloque siguiente"><span aria-hidden="true">›</span></button>
                                    </div>
                                )}
                            </div>
                            <div class="carousel" role="region" aria-label="Artículos anteriores, carrusel" tabindex="0">
                                <div class="carousel-track">
                                    {bloquesAnteriores.map((bloque) => (
                                    <div class="carousel-slide">
                                    <ul class="posts-list">
                                {bloque.map((post) => (
                                    <li class:list={['post-item', { 'post-item-with-image': Boolean(post.data.image) }]} data-search={post.searchText} data-author={post.data.author} data-post-id={post.id}>
                                <div class="older-post-content">
                                {post.data.featured && <span class="featured-badge">Destacado</span>}
                                <h2>
                                    <a class="post-title-link" href={`/${post.id}/`}>{post.data.title}</a>
                                </h2>
                                <div class="post-meta-inline">
                                    <span class="post-author-line">
                                        <button class="author-trigger" type="button" aria-label={`Ver biografía de ${post.data.author}`} title={`Abrir biografía de ${post.data.author}`}>
                                            <img class="post-author-avatar" src={getAuthorImage(post)} alt={`Foto de ${post.data.author}`} width="28" height="28" loading="lazy" decoding="async" />
                                        </button>
                                        <span>Por {post.data.author}</span>
                                        <button class="author-bio-trigger" type="button" data-author-modal={`author-modal-${post.id}`} aria-label={`Ver biografía de ${post.data.author}`} title={`Abrir biografía de ${post.data.author}`}>ver bio</button>
                                    </span>
                                    <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)} · {post.readingMinutes} min de lectura</time>
                                </div>
                                <span class="post-category-list">
                                    {post.data.category.map((category, index) => (
                                        <span>
                                            {index > 0 && <span aria-hidden="true"> / </span>}
                                            <a class="post-category-item" href={`/categorias/${slugify(category)}/`}>{category}</a>
                                        </span>
                                    ))}
                                </span>
                                {post.data.image && (
                                    <img class="older-post-image" src={post.data.image} alt={`Imagen destacada de ${post.data.title}`} loading="lazy" decoding="async" />
                                )}
                                <p class="post-description">{post.data.description}</p>
                                
                                <a class="read-more" href={`/${post.id}/`}>Leer artículo →</a>
                                <div class="author-modal" id={`author-modal-${post.id}`} hidden aria-hidden="true" role="dialog" aria-modal="true">
                                    <div class="author-modal-heading">
                                        <img class="author-modal-image" src={getAuthorImage(post)} alt={`Foto de ${post.data.author}`} width="72" height="72" loading="lazy" decoding="async" />
                                        <h2>{post.data.author}</h2>
                                    </div>
                                    <p>{getAuthorBio(post)}</p>
                                    <button class="author-modal-close" type="button">Cerrar</button>
                                </div>
                                </div>
                                    </li>
                                ))}
                            </ul>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </section>
                    )}
                    {pageCount > 1 && (
                        <nav class="pagination-container archive-pagination" aria-label="Paginación de artículos">
                            <span aria-hidden="true"></span>
                            <a class="pagination-btn next" href="/pagina/2/">
                                <span class="label">Más antiguos →</span>
                                <span class="title">Página 2</span>
                            </a>
                        </nav>
                    )}
                </>
            )}
        </main>
        <ContactForm postTitle="Consulta general del blog" />
    </div>
    <script is:inline>
        // ——— Carruseles de la portada: flechas, puntos y altura adaptable ———
        (function () {
            var fits = [];
            var mqMovil = window.matchMedia('(max-width: 560px)');
            Array.prototype.forEach.call(document.querySelectorAll('.carousel'), function (carousel) {
                var section = carousel.closest('section') || document;
                var prev = section.querySelector('.carousel-btn.prev');
                var next = section.querySelector('.carousel-btn.next');
                if (!prev || !next) return;
                var track = carousel.querySelector('.carousel-track');
                var dotsBox = section.querySelector('.carousel-dots');
                var slides = Array.prototype.slice.call(carousel.querySelectorAll('.carousel-slide'));
                var dots = Array.prototype.slice.call(section.querySelectorAll('.carousel-dot'));
                // Puntos: como máximo se muestran MAX_PUNTOS a la vez; al llegar al
                // final de la tanda visible se refresca con la siguiente (10, o las
                // que queden si es la última tanda)
                var MAX_PUNTOS = 10;
                var inicio = 0;   // primer punto de la ventana visible
                var ventana = -1;  // ventana ya pintada (-1 = pintar al iniciar)
                // Escritorio: bloques de 2 del servidor; móvil: 1 tarjeta por bloque (sin apilar)
                var porBloque = 2;
                function porDefecto() { return mqMovil.matches ? 1 : 2; }
                function regroup(n) {
                    porBloque = n;
                    var cards = Array.prototype.slice.call(track.querySelectorAll('li'));
                    var frag = document.createDocumentFragment();
                    var slide = null;
                    cards.forEach(function (card, i) {
                        if (i % n === 0) {
                            slide = document.createElement('div');
                            slide.className = 'carousel-slide';
                            var ul = document.createElement('ul');
                            ul.className = 'posts-list';
                            slide.appendChild(ul);
                            frag.appendChild(slide);
                        }
                        slide.querySelector('ul').appendChild(card);
                    });
                    track.replaceChildren(frag);
                    slides = Array.prototype.slice.call(track.querySelectorAll('.carousel-slide'));
                    carousel.scrollLeft = 0;
                    if (dotsBox && dots.length) {
                        var base = dots[0].getAttribute('aria-label').replace(/\d+$/, '');
                        var dfrag = document.createDocumentFragment();
                        for (var j = 0; j < slides.length; j++) {
                            var dot = document.createElement('button');
                            dot.className = 'carousel-dot';
                            dot.type = 'button';
                            dot.setAttribute('aria-label', base + (j + 1));
                            dot.setAttribute('aria-current', j === 0 ? 'true' : 'false');
                            dfrag.appendChild(dot);
                        }
                        dotsBox.replaceChildren(dfrag);
                        dots = Array.prototype.slice.call(dotsBox.querySelectorAll('.carousel-dot'));
                        inicio = 0;
                        ventana = -1;
                    }
                }
                function offsets() {
                    var base = carousel.getBoundingClientRect().left;
                    return slides.map(function (s) { return s.getBoundingClientRect().left - base + carousel.scrollLeft; });
                }
                function activeIndex() {
                    var pos = carousel.scrollLeft, best = 0, bestDiff = Infinity;
                    offsets().forEach(function (o, i) {
                        var d = Math.abs(o - pos);
                        if (d < bestDiff) { bestDiff = d; best = i; }
                    });
                    return best;
                }
                function fitHeight() {
                    var h = slides[activeIndex()].offsetHeight + 'px';
                    if (carousel.style.height !== h) carousel.style.height = h;
                }
                function update() {
                    var max = carousel.scrollWidth - carousel.clientWidth - 2;
                    prev.disabled = carousel.scrollLeft <= 2;
                    next.disabled = carousel.scrollLeft >= max;
                    var idx = activeIndex();
                    recalcularVentana(idx);
                    pintarVentana();
                    dots.forEach(function (d, i) { d.setAttribute('aria-current', i === idx ? 'true' : 'false'); });
                    fitHeight();
                }
                // Ventana de puntos: si el activo llega al último punto visible, se salta
                // a la siguiente tanda; la última se alinea para no pasar del total.
                function recalcularVentana(idx) {
                    if (dots.length <= MAX_PUNTOS) { inicio = 0; return; }
                    if (idx < inicio) inicio = idx;
                    else if (idx >= inicio + MAX_PUNTOS - 1) inicio = Math.min(idx, dots.length - MAX_PUNTOS);
                }
                function pintarVentana() {
                    if (ventana === inicio) return;
                    ventana = inicio;
                    dots.forEach(function (d, i) { d.hidden = i < inicio || i >= inicio + MAX_PUNTOS; });
                }
                function step(dir) { carousel.scrollBy({ left: dir * carousel.clientWidth, behavior: 'smooth' }); }
                function bindDots() {
                    dots.forEach(function (d, i) {
                        d.addEventListener('click', function () {
                            carousel.scrollTo({ left: offsets()[i], behavior: 'smooth' });
                        });
                    });
                }
                prev.addEventListener('click', function () { step(-1); });
                next.addEventListener('click', function () { step(1); });
                carousel.addEventListener('scroll', update, { passive: true });
                window.addEventListener('resize', function () {
                    if (porDefecto() !== porBloque) { regroup(porDefecto()); bindDots(); }
                    update();
                });
                carousel.addEventListener('load', fitHeight, true);
                carousel.addEventListener('keydown', function (e) {
                    if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
                    if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
                });
                if (porDefecto() !== porBloque) regroup(porDefecto());
                bindDots();
                fits.push(fitHeight);
                update();
            });
            window.__refitCarousels = function () { fits.forEach(function (f) { f(); }); };
        })();

        const searchInput = document.getElementById('blog-search-input');
        const authorFilter = document.getElementById('blog-author-filter');
        const searchForm = document.getElementById('blog-search-form');
        const posts = Array.from(document.querySelectorAll('.post-item, .featured-card'));
        const emptyState = document.getElementById('blog-empty-state');
        const countEl = document.getElementById('blog-search-count');
        const countBase = countEl?.textContent || '';
        const globalResults = document.getElementById('global-search-results');
        const searchIndexUrl = searchForm?.dataset.indexUrl || '/search-index.json';
        const siteBaseUrl = searchForm?.dataset.baseUrl || '/';
        let globalIndex = null;

        const loadGlobalIndex = async () => {
            if (globalIndex) return globalIndex;
            const response = await fetch(searchIndexUrl);
            if (!response.ok) throw new Error('No se pudo cargar el índice de búsqueda.');
            globalIndex = (await response.json()).items || [];
            return globalIndex;
        };

        const renderGlobalResults = (query, selectedAuthor = '') => {
            if (!globalResults) return;
            const matches = globalIndex.filter((item) =>
                item.text.toLowerCase().includes(query) &&
                (!selectedAuthor || item.author === selectedAuthor)
            );
            globalResults.replaceChildren();
            if (!query || matches.length === 0) {
                globalResults.hidden = true;
                return;
            }
            const heading = document.createElement('strong');
            heading.textContent = `Resultados en todo el archivo (${matches.length})`;
            globalResults.append(heading);
            const list = document.createElement('ul');
            matches.slice(0, 8).forEach((item) => {
                const li = document.createElement('li');
                const link = document.createElement('a');
                link.href = `${siteBaseUrl.replace(/\/$/, '')}${item.url}`;
                link.textContent = item.title;
                li.append(link);
                list.append(li);
            });
            globalResults.append(list);
            globalResults.hidden = false;
        };

        const applyFilters = () => {
            const query = (searchInput?.value || '').trim().toLowerCase();
            const selectedAuthor = authorFilter?.value || '';
            // Set de posts visibles: cuenta artículos únicos (los destacados se repiten en dos carruseles)
            const visibles = new Set();

            posts.forEach((post) => {
                const haystack = (post.dataset.search || post.textContent || '').toLowerCase();
                const matchesQuery = !query || haystack.includes(query);
                const matchesAuthor = !selectedAuthor || (post.dataset.author || '') === selectedAuthor;
                const match = matchesQuery && matchesAuthor;
                post.hidden = !match;
                if (match) visibles.add(post.dataset.postId || post);
            });

            document.querySelectorAll('.featured-section, .older-posts-section').forEach((section) => {
                section.hidden = !section.querySelector('.featured-card:not([hidden]), .post-item:not([hidden])');
            });

            const filtrando = Boolean(query || selectedAuthor);
            if (emptyState) emptyState.hidden = visibles.size !== 0;
            if (countEl) {
                if (filtrando) {
                    const label = visibles.size === 1 ? 'artículo' : 'artículos';
                    countEl.textContent = `${visibles.size} ${label} coincidentes`;
                } else {
                    countEl.textContent = countBase;
                }
            }
            if (query) loadGlobalIndex().then(() => renderGlobalResults(query, selectedAuthor)).catch(() => {});
            else if (globalResults) globalResults.hidden = true;
            window.__refitCarousels?.();
        };

        searchInput?.addEventListener('input', applyFilters);
        authorFilter?.addEventListener('change', applyFilters);
        searchForm?.addEventListener('submit', (event) => {
            event.preventDefault();
            applyFilters();
        });

        document.querySelectorAll('.author-modal').forEach((modal) => {
            modal.hidden = true;
            modal.setAttribute('aria-hidden', 'true');
        });

        document.querySelectorAll('[data-author-modal]').forEach((trigger) => {
            if (trigger.dataset.authorModalBound === 'true') return;
            trigger.dataset.authorModalBound = 'true';

            const modal = document.getElementById(trigger.dataset.authorModal);
            const closeButton = modal?.querySelector('.author-modal-close');
            if (!modal || !closeButton) return;

            const closeModal = () => {
                modal.hidden = true;
                modal.setAttribute('aria-hidden', 'true');
            };

            const openModal = () => {
                document.querySelectorAll('.author-modal').forEach((otherModal) => {
                    if (otherModal !== modal) {
                        otherModal.hidden = true;
                        otherModal.setAttribute('aria-hidden', 'true');
                    }
                });
                modal.hidden = false;
                modal.setAttribute('aria-hidden', 'false');
            };

            trigger.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();
                if (modal.hidden) {
                    openModal();
                    return;
                }
                closeModal();
            });

            closeButton.addEventListener('click', (event) => {
                event.preventDefault();
                closeModal();
            });

            modal.addEventListener('click', (event) => {
                if (event.target === modal) closeModal();
            });
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                document.querySelectorAll('.author-modal').forEach((modal) => {
                    modal.hidden = true;
                    modal.setAttribute('aria-hidden', 'true');
                });
            }
        });
    </script>
    <BackToTop slot="after-footer" />
</Layout>

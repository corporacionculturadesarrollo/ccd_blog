---
import { getCollection } from 'astro:content';
import BackToTop from '../../components/BackToTop.astro';
import Layout from '../../layouts/Layout.astro';
import { slugify } from '../../lib/slugify';

const posts = await getCollection('blog');
const categories = [...new Map(
  posts
    .flatMap((post) => post.data.category)
    .map((category) => [slugify(category), category])
)].sort(([, firstName], [, secondName]) => firstName.localeCompare(secondName, 'es'));
---

<Layout
    title="Categorías | Blog Cultura y Desarrollo"
    description="Explora los artículos del Blog de Cultura y Desarrollo agrupados por tema."
>
    <main style="max-width: 850px; margin: 0 auto; padding: 7rem 1.5rem 3rem;">
        <a href="/" style="color: var(--color-secondary); text-decoration: none; font-size: 0.95rem;">← Volver al inicio del blog</a>
        <header style="margin: 1.5rem 0 2rem;">
            <h1 style="color: var(--color-primary); font-size: 2.3rem; margin-bottom: 0.5rem;">Categorías</h1>
            <p style="color: #667085; margin: 0;">Explora los artículos agrupados por tema.</p>
        </header>

        <ul style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; list-style: none; padding: 0;">
            {categories.map(([categorySlug, categoryName]) => (
                <li style="background: var(--color-bg-alt); border-left: 4px solid var(--color-secondary); border-radius: 8px; padding: 1.25rem;">
                    <a href={`/categorias/${categorySlug}/`} style="color: var(--color-primary); font-size: 1.1rem; font-weight: 700; text-decoration: none;">
                        {categoryName}
                    </a>
                </li>
            ))}
        </ul>
    </main>
    <BackToTop slot="after-footer" />
</Layout>
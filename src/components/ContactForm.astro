---
const { postTitle, postAuthor, postDate } = Astro.props;
const messageHeader = postAuthor && postDate
  ? `Referencia: ${postTitle} · ${postAuthor} · ${postDate}`
  : '';
const isGeneralContact = postTitle === 'Consulta general del blog';
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID || 'mkoearok';
// Fase 3 (ccd-infra): si hay API propia configurada, el formulario va a ella;
// si no, se conserva Formspree como respaldo (estado actual de producción).
const apiBase = (import.meta.env.PUBLIC_API_URL || '').replace(/\/+$/, '');
const formAction = apiBase ? `${apiBase}/api/contact` : `https://formspree.io/f/${formspreeId}`;
---

<dialog class="contact-dialog" id="contacto" aria-labelledby="contact-title">
  <h2 id="contact-title">{isGeneralContact ? 'Ponte en contacto con nosotros' : 'Escríbenos sobre este artículo'}</h2>
  <p class="contact-intro">Envíanos tus comentarios, preguntas o propuestas relacionadas con este contenido.</p>

  <form id="contact-form" class="contact-form" action={formAction || undefined} method="POST" data-api={apiBase} novalidate>
    <input type="hidden" name="_subject" value={`Mensaje sobre: ${postTitle}`} />
    <input type="hidden" name="article" value={postTitle} />
    {messageHeader && <input type="hidden" name="article_context" value={messageHeader} data-base={messageHeader} />}
    {messageHeader && <input id="contact-rating" type="hidden" name="rating" value="Sin valoración" />}
    <div class="visually-hidden">
      <label for="website">No rellenes este campo si eres humano</label>
      <input id="website" name="website" type="text" autocomplete="off" tabindex="-1" />
    </div>

    <div class="contact-row">
      <div class="contact-field">
        <label for="contact-name">Nombre</label>
        <input id="contact-name" name="name" type="text" autocomplete="off" autofocus required minlength="2" aria-describedby="contact-name-error" placeholder="Escribe tu nombre o la organización que representas." />
        <small id="contact-name-error" class="field-error" aria-live="polite"></small>
      </div>

      <div class="contact-field">
        <label for="contact-email">Correo electrónico</label>
        <input id="contact-email" name="email" type="email" autocomplete="off" required aria-describedby="contact-email-error" placeholder="Usaremos este correo solo para responder tu mensaje." />
        <small id="contact-email-error" class="field-error" aria-live="polite"></small>
      </div>
    </div>

    <div class="contact-field">
      <label for="contact-message">Mensaje</label>
      {messageHeader && (
        <small id="contact-context" class="message-context" data-base={messageHeader} aria-label="Referencia del artículo">
          Referencia: {postTitle} · {postAuthor} · {postDate}
        </small>
      )}
      <textarea id="contact-message" name="message" rows="4" required minlength="20" autocomplete="off" aria-describedby="contact-message-help contact-message-error" placeholder="Escribe aquí tu comentario o pregunta..."></textarea>
      <small id="contact-message-help" class="field-help">Escribe al menos 20 caracteres para enviar tu mensaje.</small>
      <small id="contact-message-error" class="field-error" aria-live="polite"></small>
    </div>

    <button type="submit">enviar mensaje</button>

    <p class="form-privacy">
      Tu mensaje se enviará por correo electrónico. No usamos estos datos para fines publicitarios ni los compartimos con terceros.
    </p>
    <p class="form-status" aria-live="polite" role="status"></p>
  </form>

  <dialog id="contact-success-dialog" class="contact-success-dialog" aria-labelledby="contact-success-title">
    <div class="contact-success-content">
      <h3 id="contact-success-title">Mensaje enviado</h3>
      <p>Gracias por escribirnos.</p>
      <button type="button" class="contact-success-close">Cerrar</button>
    </div>
  </dialog>

  <a href="#top" class="contact-dialog-close">Cerrar</a>
</dialog>

{/* Confirmación fuera del <dialog>: el top layer del modal la taparía */}
<div id="contact-success-toast" class="contact-success-toast" role="status" aria-live="polite" hidden>
  <span class="contact-success-toast-icon" aria-hidden="true">✓</span>
  <span>Mensaje enviado correctamente.</span>
</div>

<style>
  /* Modal: el formulario solo se ve como <dialog> */
  .contact-dialog {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    box-shadow: 0 18px 50px rgba(36, 19, 15, 0.24);
    color: var(--color-text);
    margin: auto;
    max-height: min(86vh, 760px);
    overflow: auto;
    padding: 1.5rem 1.6rem 1.4rem;
    width: min(640px, calc(100vw - 2rem));
  }

  .contact-dialog::backdrop {
    background: rgba(36, 19, 15, 0.45);
  }

  /* Sin JavaScript, el hash #contacto muestra el formulario centrado */
  .contact-dialog:not([open]):target {
    display: block;
    left: 50%;
    max-height: 86vh;
    position: fixed;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 1001;
  }

  .contact-dialog h2 {
    color: var(--color-primary);
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  /* Es un <a href="#top"> para poder cerrar también sin JavaScript:
     quita el hash y con él el fallback :target */
  .contact-dialog-close {
    background: var(--color-primary);
    border: 0;
    border-radius: 4px;
    color: #ffffff;
    cursor: pointer;
    display: block;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    margin: 1.2rem auto 0;
    padding: 0.65rem 1.4rem;
    text-align: center;
    text-decoration: none;
    width: fit-content;
  }

  .contact-dialog-close:hover,
  .contact-dialog-close:focus-visible {
    background: var(--color-secondary);
  }

  .contact-intro {
    color: var(--color-text);
    margin: 0 0 1.25rem;
  }

  /* Marco claro: reúne todo el módulo de correo en una sola pieza */
  .contact-form {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    display: grid;
    gap: 0.5rem;
    max-width: 560px;
    padding: 1rem 1.1rem 1.15rem;
  }

  /* Nombre y correo en paralelo: campos más estrechos */
  .contact-row {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .contact-field {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .contact-form label {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
    margin-top: 0;
  }

  .contact-form input,
  .contact-form textarea {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text);
    font: inherit;
    line-height: 1.4;
    padding: 0.55rem 0.7rem;
    width: 100%;
  }

  .contact-form ::placeholder {
    color: #98a2b3;
    opacity: 1;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--color-secondary);
    outline: 2px solid color-mix(in srgb, var(--color-secondary) 25%, transparent);
  }

  .contact-form input[aria-invalid='true'],
  .contact-form textarea[aria-invalid='true'] {
    border-color: #b42318;
    box-shadow: 0 0 0 2px rgba(180, 35, 24, 0.08);
  }

  .field-help {
    color: #667085;
    font-size: 0.8rem;
    margin-top: -0.1rem;
  }

  .field-error {
    color: #b42318;
    display: block;
    font-size: 0.78rem;
    min-height: 1rem;
    margin-top: -0.15rem;
  }

  .message-context {
    color: #667085;
    font-size: 0.78rem;
    line-height: 1.4;
    margin-top: -0.1rem;
  }

  .contact-form textarea {
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .form-privacy {
    background: var(--color-bg);
    border-left: 3px solid var(--color-secondary);
    color: var(--color-text);
    font-size: 0.82rem;
    line-height: 1.6;
    margin: 0.15rem 0 0;
    padding: 0.7rem 0.85rem;
  }

  .form-status {
    color: var(--color-primary);
    font-size: 0.9rem;
    min-height: 1.25rem;
    margin: 0.15rem 0 0;
  }

  .form-status.success {
    background: rgba(20, 128, 71, 0.1);
    border: 1px solid rgba(20, 128, 71, 0.35);
    border-radius: 6px;
    color: #147a3c;
    display: block;
    font-weight: 700;
    margin-top: 0.75rem;
    padding: 0.7rem 0.8rem;
  }

  .contact-success-dialog {
    border: 0;
    border-radius: 8px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
    max-width: 280px;
    padding: 0;
    width: min(84vw, 280px);
  }

  .contact-success-dialog::backdrop {
    background: rgba(24, 26, 27, 0.32);
  }

  .contact-success-content {
    padding: 0.8rem 0.9rem 0.7rem;
    text-align: center;
  }

  .contact-success-toast {
    position: fixed;
    right: 1rem;
    top: 1rem;
    /* Por encima de la barra fija (1000), por debajo de .skip-link
       y .author-modal (2000) */
    z-index: 1100;
    background: rgba(20, 128, 71, 0.97);
    border-radius: 10px;
    box-shadow: 0 12px 24px rgba(18, 53, 36, 0.25);
    color: #fff;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.9rem;
    font-weight: 700;
    max-width: min(88vw, 320px);
    opacity: 0;
    padding: 0.8rem 1rem;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .contact-success-toast.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Sin esta regla, display:flex anula el atributo hidden */
  .contact-success-toast[hidden] {
    display: none;
  }

  .contact-success-toast-icon {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    height: 1.4rem;
    min-width: 1.4rem;
    width: 1.4rem;
  }

  .contact-success-content h3 {
    color: var(--color-primary);
    font-size: 1.05rem;
    margin: 0 0 0.35rem;
  }

  .contact-success-content p {
    color: var(--color-text);
    font-size: 0.9rem;
    margin: 0 0 0.8rem;
    line-height: 1.4;
  }

  .contact-success-close {
    background: var(--color-primary);
    border: 0;
    border-radius: 4px;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.55rem 0.85rem;
  }

  .contact-form button {
    background: var(--color-primary);
    border: 0;
    border-radius: 4px;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    margin-left: auto;
    margin-top: 0.15rem;
    padding: 0.5rem 0.9rem;
    width: fit-content;
  }

  .contact-form button:hover,
  .contact-form button:focus-visible {
    background: var(--color-secondary);
  }

  @media (max-width: 560px) {
    .contact-row {
      grid-template-columns: 1fr;
    }

    /* En móvil nombre y correo se apilan pero quedan estrechos */
    .contact-row input {
      max-width: min(100%, 340px);
    }
  }

  .visually-hidden {
    border: 0;
    clip: rect(0 0 0 0);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
</style>

<script>
  // --- Modal de contacto: apertura por enlaces y cierre -------------------
  const contactDialog = document.getElementById('contacto');
  const dialogAvailable = contactDialog instanceof HTMLDialogElement;

  // Con el hash puesto, el fallback :target re-aparecería como caja fija
  // al cerrar el modal: se limpia en cuanto se abre con JavaScript.
  const clearContactHash = () => {
    if (window.location.hash === '#contacto') {
      window.history.replaceState(null, '', window.location.pathname + window.location.search);
    }
  };

  const openContactDialog = () => {
    // Limpiar el hash primero: si se llega con #contacto, el fallback
    // :target re-aparecería como caja fija cuando se cierre el modal.
    clearContactHash();
    if (!dialogAvailable || contactDialog.open) return;
    const statusEl = document.querySelector('form.contact-form .form-status');
    if (statusEl && statusEl.classList.contains('success')) {
      statusEl.textContent = '';
      statusEl.classList.remove('success');
    }
    contactDialog.showModal();
  };

  if (dialogAvailable) {
    // Cerrar como <a href="#top">: con JavaScript se cierra el modal; sin él,
    // quita el hash y con él el fallback :target (caja fija).
    contactDialog
      .querySelector('.contact-dialog-close')
      ?.addEventListener('click', (event) => {
        event.preventDefault();
        contactDialog.close();
      });

    // Cierre con el fondo (backdrop): el click llega con target === dialog,
    // pero solo cuenta si las coordenadas caen fuera de la caja.
    contactDialog.addEventListener('click', (event) => {
      if (event.target !== contactDialog) return;
      const rect = contactDialog.getBoundingClientRect();
      const inside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;
      if (!inside) contactDialog.close();
    });
    // El Escape lo cierra el navegador de forma nativa.
  }

  // Enlaces "Contacto" (#contacto y /#contacto): si el modal existe en esta
  // página se abre sin navegar; si no (p. ej. /acerca), se navega y allí
  // el hash dispare la apertura al cargar.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const anchor = target.closest('a[href]');
    if (!anchor) return;
    const href = anchor.getAttribute('href') || '';
    if (href !== '#contacto' && href !== '/#contacto') return;
    if (!dialogAvailable) return;
    // Ctrl/Cmd+click sigue abriendo la pestaña nueva.
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    openContactDialog();
  });

  if (window.location.hash === '#contacto') {
    openContactDialog();
  }
  window.addEventListener('hashchange', () => {
    if (window.location.hash !== '#contacto') return;
    openContactDialog();
  });

  // --- Formulario ---------------------------------------------------------
  const form = document.querySelector('form.contact-form');
  if (form && form instanceof HTMLFormElement) {
    const status = form.querySelector('.form-status');
    const honeypot = form.querySelector('#website');
    const inputs = form.querySelectorAll('input[required], textarea[required]');
    const submitButton = form.querySelector('button[type="submit"]');

    const errorMessages = {
      name: 'Introduce tu nombre o la organización que representas.',
      email: 'Escribe un correo electrónico válido.',
      message: 'El mensaje debe tener al menos 20 caracteres.'
    };

    const validateField = (field) => {
      const value = field.value.trim();
      const minLength = Number(field.minLength || 0);
      const isEmpty = value.length === 0;
      const isTooShort = minLength > 0 && value.length > 0 && value.length < minLength;
      const isInvalidEmail = field.type === 'email' && value.length > 0 && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      const hasError = isEmpty || isTooShort || isInvalidEmail;
      const errorElement = field.parentElement?.querySelector(`#${field.id}-error`);

      field.setAttribute('aria-invalid', hasError ? 'true' : 'false');
      field.setCustomValidity(hasError ? 'Campo requerido o inválido.' : '');

      if (errorElement) {
        if (hasError) {
          if (field.type === 'email' && value.length > 0 && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
            errorElement.textContent = errorMessages.email;
          } else if (field.name === 'message' && isTooShort) {
            errorElement.textContent = errorMessages.message;
          } else if (field.name === 'name' && isEmpty) {
            errorElement.textContent = errorMessages.name;
          } else if (field.name === 'name' && isTooShort) {
            errorElement.textContent = 'El nombre debe tener al menos 2 caracteres.';
          } else if (field.name === 'email' && isEmpty) {
            errorElement.textContent = 'El correo electrónico es obligatorio.';
          } else if (field.name === 'message' && isEmpty) {
            errorElement.textContent = 'Escribe un mensaje antes de enviar.';
          } else {
            errorElement.textContent = errorMessages[field.name] || 'Este campo es obligatorio.';
          }
        } else {
          errorElement.textContent = '';
        }
      }

      return !hasError;
    };

    const resetFormState = () => {
      form.reset();
      inputs.forEach((input) => {
        input.setAttribute('aria-invalid', 'false');
        input.setCustomValidity('');
        const errorElement = input.parentElement?.querySelector(`#${input.id}-error`);
        if (errorElement) errorElement.textContent = '';
      });
      if (submitButton) submitButton.disabled = false;
      if (status) {
        status.textContent = '';
        status.classList.remove('success');
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const showStatus = (message, isSuccess = false) => {
      if (status) {
        status.textContent = message;
        status.classList.toggle('success', isSuccess);
      }
    };

    const successToast = document.getElementById('contact-success-toast');
    let toastTimer = null;

    const goToTop = () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const showSuccessToast = () => {
      if (!successToast) return;
      successToast.hidden = false;
      // Reflow forzado: sin él, display y opacity cambian en el mismo
      // recálculo de estilos y el toast aparecería sin transición.
      void successToast.offsetWidth;
      successToast.classList.add('visible');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        successToast.classList.remove('visible');
        setTimeout(() => {
          successToast.hidden = true;
        }, 220);
      }, 4200);
    };

    const hideSuccessToast = () => {
      if (!successToast) return;
      successToast.classList.remove('visible');
      setTimeout(() => {
        successToast.hidden = true;
      }, 220);
    };

    // Confirmación → formulario vaciado → cierre del modal. El toast vive
    // fuera del <dialog> para que, al cerrarlo, siga visible en la página.
    // Solo se vacían los campos visibles: los hidden (referencia y
    // valoración) conservan el estado de las estrellas.
    let closeTimer = null;
    let awaitingClose = false;
    const finishSuccessfulSend = () => {
      showStatus('Mensaje enviado correctamente. Gracias por escribirnos.', true);
      form.querySelectorAll('input:not([type="hidden"]), textarea').forEach((field) => {
        field.value = '';
      });
      awaitingClose = true;
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        closeTimer = null;
        // Se marca antes de cerrar: el evento "close" de este cierre
        // automático no debe confundirse con un cierre manual del usuario.
        awaitingClose = false;
        if (dialogAvailable && contactDialog.open) contactDialog.close();
        if (submitButton) submitButton.disabled = false;
        showSuccessToast();
      }, 1500);
    };

    // Cierre manual (botón, backdrop o Esc) dentro de la ventana de espera:
    // se cancela el cierre automático pendiente para que el modal no se vuelva
    // a cerrar solo si el usuario lo reabre, y la confirmación pasa al toast.
    if (dialogAvailable) {
      contactDialog.addEventListener('close', () => {
        if (!awaitingClose) return;
        window.clearTimeout(closeTimer);
        closeTimer = null;
        awaitingClose = false;
        if (submitButton) submitButton.disabled = false;
        showSuccessToast();
      });
    }

    inputs.forEach((input) => {
      input.addEventListener('input', () => validateField(input));
      input.addEventListener('blur', () => validateField(input));
    });

    if (!form.action || form.action === window.location.href) {
      showStatus('El servicio de correo no está configurado. Contacta al administrador para habilitar los mensajes.');
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        showStatus('El servicio de correo no está configurado. Contacta al administrador para habilitar los mensajes.');
      });
    } else {
      const apiBase = form.dataset.api || '';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const honeypotValue = honeypot ? honeypot.value.trim() : '';
        if (honeypotValue) {
          showStatus('El formulario no pudo enviarse. Inténtalo de nuevo.');
          return;
        }

        let isValid = true;
        inputs.forEach((input) => {
          if (!validateField(input)) isValid = false;
        });

        if (!isValid) {
          showStatus('Completa todos los campos correctamente antes de enviar el mensaje.');
          return;
        }

        if (submitButton) submitButton.disabled = true;
        showStatus('Enviando mensaje…');

        // Fase 3 (ccd-infra): con API propia se envía JSON y la referencia
        // del artículo y la valoración se pliegan dentro del mensaje.
        if (apiBase) {
          try {
            const fields = new FormData(form);
            const partes = [];
            const contexto = String(fields.get('article_context') || '').trim();
            const valoracion = String(fields.get('rating') || '').trim();
            if (contexto) partes.push(contexto);
            if (valoracion && valoracion !== 'Sin valoración') partes.push(`Valoración: ${valoracion}`);
            partes.push(String(fields.get('message') || '').trim());
            const cuerpo = partes.join('\n\n');
            if (cuerpo.length > 2000) {
              showStatus('El mensaje es demasiado largo: máximo 2000 caracteres.');
              return;
            }

            const response = await fetch(form.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({
                nombre: String(fields.get('name') || '').trim(),
                email: String(fields.get('email') || '').trim(),
                mensaje: cuerpo,
                origen: 'blog',
                website: '',
              }),
            });
            if (!response.ok) throw new Error(`API ${response.status}`);
            finishSuccessfulSend();
          } catch {
            showStatus('No se pudo enviar el mensaje. Inténtalo de nuevo más tarde.');
          } finally {
            if (submitButton && !awaitingClose) submitButton.disabled = false;
          }
          return;
        }

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (response.status === 403) {
            // AJAX bloqueado por el panel de Formspree: volver al envío
            // nativo para que aparezca su página de verificación/captcha.
            showStatus('Verificación adicional requerida. Redirigiendo…');
            form.submit();
            return;
          }
          if (!response.ok) throw new Error('Formspree error');
          finishSuccessfulSend();
        } catch (error) {
          // Si el fetch ni siquiera salió (red), intentar envío nativo
          // como antes; si ya veníamos de un fallo, mostrar el error.
          if (error instanceof TypeError) {
            showStatus('Verificación adicional requerida. Redirigiendo…');
            form.submit();
            return;
          }
          showStatus('No se pudo enviar el mensaje. Inténtalo de nuevo más tarde.');
        } finally {
          if (submitButton && !awaitingClose) submitButton.disabled = false;
        }
      });
    }

    window.addEventListener('pageshow', (event) => {
      if (event.persisted || event.type === 'pageshow') {
        resetFormState();
      }
    });

    window.addEventListener('load', () => {
      resetFormState();
    });
  }
</script>

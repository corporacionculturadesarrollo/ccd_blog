---
const { postTitle, postAuthor, postDate } = Astro.props;
const messageHeader = postAuthor && postDate
  ? `Referencia: ${postTitle} · ${postAuthor} · ${postDate}`
  : '';
const isGeneralContact = postTitle === 'Consulta general del blog';
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const formAction = formspreeId ? `https://formspree.io/f/${formspreeId}` : '';
---

<section class="contact-section" id="contacto" aria-labelledby="contact-title">
  <h2 id="contact-title">{isGeneralContact ? 'Ponte en contacto con nosotros' : 'Escríbenos sobre este artículo'}</h2>
  <p class="contact-intro">Envíanos tus comentarios, preguntas o propuestas relacionadas con este contenido.</p>

  <div id="contact-success-toast" class="contact-success-toast" role="status" aria-live="polite" hidden>
    <span class="contact-success-toast-icon" aria-hidden="true">✓</span>
    <span>Mensaje enviado correctamente.</span>
  </div>

  <form id="contact-form" class="contact-form" action={formAction || undefined} method="POST" novalidate>
    <input type="hidden" name="_subject" value={`Mensaje sobre: ${postTitle}`} />
    <input type="hidden" name="article" value={postTitle} />
    {messageHeader && <input type="hidden" name="article_context" value={messageHeader} data-base={messageHeader} />}
    {messageHeader && <input id="contact-rating" type="hidden" name="rating" value="Sin valoración" />}
    <div class="visually-hidden">
      <label for="website">No rellenes este campo si eres humano</label>
      <input id="website" name="website" type="text" autocomplete="off" tabindex="-1" />
    </div>

    <label for="contact-name">Nombre</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required minlength="2" aria-describedby="contact-name-help contact-name-error" />
    <small id="contact-name-help" class="field-help">Escribe tu nombre o la organización que representas.</small>
    <small id="contact-name-error" class="field-error" aria-live="polite"></small>

    <label for="contact-email">Correo electrónico</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required aria-describedby="contact-email-help contact-email-error" />
    <small id="contact-email-help" class="field-help">Usaremos este correo solo para responder tu mensaje.</small>
    <small id="contact-email-error" class="field-error" aria-live="polite"></small>

    <label for="contact-message">Mensaje</label>
    {messageHeader && (
      <small id="contact-context" class="message-context" data-base={messageHeader} aria-label="Referencia del artículo">
        Referencia: {postTitle} · {postAuthor} · {postDate}
      </small>
    )}
    <textarea id="contact-message" name="message" rows="5" required minlength="20" aria-describedby="contact-message-help contact-message-error" placeholder="Escribe aquí tu comentario o pregunta..."></textarea>
    <small id="contact-message-help" class="field-help">Escribe al menos 20 caracteres para enviar tu mensaje.</small>
    <small id="contact-message-error" class="field-error" aria-live="polite"></small>

    <button type="submit">enviar mensaje</button>

    <p class="form-privacy">
      Tu mensaje se enviará por correo electrónico. No usamos estos datos para fines publicitarios ni los compartimos con terceros.
    </p>
    <p class="form-status" aria-live="polite" role="status"></p>
  </form>

  <dialog id="contact-success-dialog" class="contact-success-dialog" aria-labelledby="contact-success-title">
    <div class="contact-success-content">
      <h3 id="contact-success-title">Mensaje enviado</h3>
      <p>Gracias por escribirnos.</p>
      <button type="button" class="contact-success-close">Cerrar</button>
    </div>
  </dialog>
</section>

<style>
  .contact-section {
    border-top: 2px solid var(--color-border);
    margin-top: 3rem;
    padding-top: 2rem;
  }

  .contact-section h2 {
    color: var(--color-primary);
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  .contact-intro {
    color: var(--color-text);
    margin: 0 0 1.25rem;
  }

  .contact-form {
    display: grid;
    gap: 0.55rem;
    max-width: 620px;
  }

  .contact-form label {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
    margin-top: 0.45rem;
  }

  .contact-form input,
  .contact-form textarea {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text);
    font: inherit;
    padding: 0.7rem 0.8rem;
    width: 100%;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--color-secondary);
    outline: 2px solid color-mix(in srgb, var(--color-secondary) 25%, transparent);
  }

  .contact-form input[aria-invalid='true'],
  .contact-form textarea[aria-invalid='true'] {
    border-color: #b42318;
    box-shadow: 0 0 0 2px rgba(180, 35, 24, 0.08);
  }

  .field-help {
    color: #667085;
    font-size: 0.8rem;
    margin-top: -0.2rem;
  }

  .field-error {
    color: #b42318;
    display: block;
    font-size: 0.78rem;
    min-height: 1rem;
    margin-top: -0.2rem;
  }

  .message-context {
    color: #667085;
    font-size: 0.78rem;
    line-height: 1.4;
    margin-top: -0.2rem;
  }

  .contact-form textarea {
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .form-privacy {
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-secondary);
    color: var(--color-text);
    font-size: 0.82rem;
    line-height: 1.6;
    margin: 0.35rem 0 0;
    padding: 0.7rem 0.85rem;
  }

  .form-status {
    color: var(--color-primary);
    font-size: 0.9rem;
    min-height: 1.25rem;
    margin: 0.25rem 0 0;
  }

  .form-status.success {
    background: rgba(20, 128, 71, 0.1);
    border: 1px solid rgba(20, 128, 71, 0.35);
    border-radius: 6px;
    color: #147a3c;
    display: block;
    font-weight: 700;
    margin-top: 0.75rem;
    padding: 0.7rem 0.8rem;
  }

  .contact-success-dialog {
    border: 0;
    border-radius: 8px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
    max-width: 280px;
    padding: 0;
    width: min(84vw, 280px);
  }

  .contact-success-dialog::backdrop {
    background: rgba(24, 26, 27, 0.32);
  }

  .contact-success-content {
    padding: 0.8rem 0.9rem 0.7rem;
    text-align: center;
  }

  .contact-success-toast {
    position: fixed;
    right: 1rem;
    top: 1rem;
    z-index: 1000;
    background: rgba(20, 128, 71, 0.97);
    border-radius: 10px;
    box-shadow: 0 12px 24px rgba(18, 53, 36, 0.25);
    color: #fff;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.9rem;
    font-weight: 700;
    max-width: min(88vw, 320px);
    opacity: 0;
    padding: 0.8rem 1rem;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .contact-success-toast.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .contact-success-toast-icon {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    height: 1.4rem;
    min-width: 1.4rem;
    width: 1.4rem;
  }

  .contact-success-content h3 {
    color: var(--color-primary);
    font-size: 1.05rem;
    margin: 0 0 0.35rem;
  }

  .contact-success-content p {
    color: var(--color-text);
    font-size: 0.9rem;
    margin: 0 0 0.8rem;
    line-height: 1.4;
  }

  .contact-success-close {
    background: var(--color-primary);
    border: 0;
    border-radius: 4px;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.55rem 0.85rem;
  }

  .contact-form button {
    background: var(--color-primary);
    border: 0;
    border-radius: 4px;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    margin-left: auto;
    margin-top: -0.3rem;
    padding: 0.45rem 0.7rem;
    width: fit-content;
  }

  .contact-form button:hover,
  .contact-form button:focus-visible {
    background: var(--color-secondary);
  }

  .visually-hidden {
    border: 0;
    clip: rect(0 0 0 0);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
</style>

<script src="https://unpkg.com/@formspree/ajax@1" defer></script>
<script>
  const form = document.querySelector('form.contact-form');
  if (form && form instanceof HTMLFormElement) {
    const status = form.querySelector('.form-status');
    const honeypot = form.querySelector('#website');
    const inputs = form.querySelectorAll('input[required], textarea[required]');
    const submitButton = form.querySelector('button[type="submit"]');

    const errorMessages = {
      name: 'Introduce tu nombre o la organización que representas.',
      email: 'Escribe un correo electrónico válido.',
      message: 'El mensaje debe tener al menos 20 caracteres.'
    };

    const validateField = (field) => {
      const value = field.value.trim();
      const minLength = Number(field.minLength || 0);
      const isEmpty = value.length === 0;
      const isTooShort = minLength > 0 && value.length > 0 && value.length < minLength;
      const isInvalidEmail = field.type === 'email' && value.length > 0 && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      const hasError = isEmpty || isTooShort || isInvalidEmail;
      const errorElement = field.parentElement?.querySelector(`#${field.id}-error`);

      field.setAttribute('aria-invalid', hasError ? 'true' : 'false');
      field.setCustomValidity(hasError ? 'Campo requerido o inválido.' : '');

      if (errorElement) {
        if (hasError) {
          if (field.type === 'email' && value.length > 0 && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
            errorElement.textContent = errorMessages.email;
          } else if (field.name === 'message' && isTooShort) {
            errorElement.textContent = errorMessages.message;
          } else if (field.name === 'name' && isEmpty) {
            errorElement.textContent = errorMessages.name;
          } else if (field.name === 'name' && isTooShort) {
            errorElement.textContent = 'El nombre debe tener al menos 2 caracteres.';
          } else if (field.name === 'email' && isEmpty) {
            errorElement.textContent = 'El correo electrónico es obligatorio.';
          } else if (field.name === 'message' && isEmpty) {
            errorElement.textContent = 'Escribe un mensaje antes de enviar.';
          } else {
            errorElement.textContent = errorMessages[field.name] || 'Este campo es obligatorio.';
          }
        } else {
          errorElement.textContent = '';
        }
      }

      return !hasError;
    };

    const resetFormState = () => {
      form.reset();
      inputs.forEach((input) => {
        input.setAttribute('aria-invalid', 'false');
        input.setCustomValidity('');
        const errorElement = input.parentElement?.querySelector(`#${input.id}-error`);
        if (errorElement) errorElement.textContent = '';
      });
      if (submitButton) submitButton.disabled = false;
      if (status) {
        status.textContent = '';
        status.classList.remove('success');
      }
    };

    const showStatus = (message, isSuccess = false) => {
      if (status) {
        status.textContent = message;
        status.classList.toggle('success', isSuccess);
      }
    };

    const successToast = document.getElementById('contact-success-toast');
    let toastTimer = null;

    const goToTop = () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const showSuccessToast = () => {
      if (!successToast) return;
      successToast.hidden = false;
      successToast.classList.add('visible');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        successToast.classList.remove('visible');
        setTimeout(() => {
          successToast.hidden = true;
        }, 220);
      }, 4200);
    };

    const hideSuccessToast = () => {
      if (!successToast) return;
      successToast.classList.remove('visible');
      setTimeout(() => {
        successToast.hidden = true;
      }, 220);
    };

    inputs.forEach((input) => {
      input.addEventListener('input', () => validateField(input));
      input.addEventListener('blur', () => validateField(input));
    });

    if (!form.action || form.action === window.location.href) {
      showStatus('El servicio de correo no está configurado. Contacta al administrador para habilitar los mensajes.');
    } else {
      form.addEventListener('submit', (event) => {
        const honeypotValue = honeypot ? honeypot.value.trim() : '';
        if (honeypotValue) {
          event.preventDefault();
          showStatus('El formulario no pudo enviarse. Inténtalo de nuevo.');
          return;
        }

        let isValid = true;
        inputs.forEach((input) => {
          if (!validateField(input)) isValid = false;
        });

        if (!isValid) {
          event.preventDefault();
          showStatus('Completa todos los campos correctamente antes de enviar el mensaje.');
        }
      });

      const formspreeFormId = `${formspreeId || 'mkoearok'}`;
      window.formspree = window.formspree || function () { (window.formspree.q = window.formspree.q || []).push(arguments); };
      window.formspree('initForm', { formElement: '#contact-form', formId: formspreeFormId });
    }

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        resetFormState();
      }
    });

    window.addEventListener('load', () => {
      resetFormState();
    });
  }
</script>

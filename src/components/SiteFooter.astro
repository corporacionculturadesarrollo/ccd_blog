---
/* Pie de página institucional del blog */
const year = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/categorias/', label: 'Categorías' },
  { href: '/tags/', label: 'Etiquetas' },
  { href: '/archivo/', label: 'Archivo' },
  { href: '/autores/', label: 'Autores' },
  { href: '/acerca/', label: 'Acerca de' },
  { href: '/#contacto', label: 'Contacto' },
  { href: '/rss.xml', label: 'RSS' },
];

const instagramUrl = 'https://www.instagram.com/corporacioncyd/';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a
        href="https://culturaydesarrollo.org"
        class="footer-name"
        rel="noopener noreferrer"
      >Corporación Cultura y Desarrollo</a>
      <p class="footer-tagline">Cultura · Memoria · Comunidad · Territorio</p>
      <p class="footer-place">Tolima · Colombia</p>
    </div>

    <nav class="footer-nav" aria-label="Navegación del pie de página">
      {navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>

    <div class="footer-social">
      <p class="footer-social-title">Síguenos</p>
      <a
        class="footer-social-link"
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de la Corporación Cultura y Desarrollo"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            fill-rule="evenodd"
            d="M7 1h10a6 6 0 0 1 6 6v10a6 6 0 0 1-6 6H7a6 6 0 0 1-6-6V7a6 6 0 0 1 6-6Zm0 2a4 4 0 0 0-4 4v10a4 4 0 0 0 4 4h10a4 4 0 0 0 4-4V7a4 4 0 0 0-4-4Zm5 3.5A5.5 5.5 0 1 1 6.5 12 5.5 5.5 0 0 1 12 6.5Zm0 2A3.5 3.5 0 1 0 15.5 12 3.5 3.5 0 0 0 12 8.5ZM18.2 5.3a1.3 1.3 0 1 1-1.3 1.3 1.3 1.3 0 0 1 1.3-1.3Z"
          />
        </svg>
        <span>Instagram</span>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {year} Corporación Cultura y Desarrollo · Desarrollo y Webmaster: Dimitri Guzmán</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    color: var(--color-text);
    margin-top: 4rem;
    padding: 2.5rem 1.25rem 1.5rem;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer-brand {
    flex: 1 1 240px;
    min-width: 220px;
  }

  .footer-name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-heading);
    text-decoration: none;
  }

  .footer-name:hover {
    color: var(--color-secondary);
  }

  .footer-tagline {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .footer-place {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .footer-nav {
    flex: 1 1 320px;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
  }

  .footer-nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .footer-nav a:hover {
    color: var(--color-secondary);
    text-decoration: underline;
  }

  .footer-social {
    flex: 0 1 auto;
  }

  .footer-social-title {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-heading);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-strong);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .footer-social-link:hover {
    color: var(--color-secondary);
    border-color: var(--color-secondary);
  }

  .footer-bottom {
    max-width: 1100px;
    margin: 2rem auto 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 1.5rem;
    }

    .footer-brand,
    .footer-nav {
      flex-basis: auto;
      min-width: 0;
    }
  }
</style>

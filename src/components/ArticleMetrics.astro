---
/**
 * Métricas del artículo (Fase 4.5 de ccd-infra): visitas, lecturas y likes.
 * Solo se emite si el blog se construye con PUBLIC_API_URL definida;
 * sin esa variable la página queda exactamente igual que hoy.
 *
 * - Visitas: una petición por carga de página (solo panel, nunca en el post).
 * - Lecturas: una por sesión, al llegar al ≥75 % de la página.
 * - Likes: botón ♥, uno por navegador (localStorage).
 *
 * Presentación (opción A con umbral): el post SIEMPRE muestra el botón ♥,
 * pero las cifras solo aparecen al superar su umbral; por debajo el número
 * queda oculto y el lector solo ve el feedback «Te gusta». Ocultar la cifra
 * no corta la medición: las 3 métricas completas están siempre en el panel.
 */
interface Props {
  articleId: string;
}
const { articleId } = Astro.props;
const apiBase = (import.meta.env.PUBLIC_API_URL || '').replace(/\/+$/, '');
const api = apiBase ? `${apiBase}/api/articles/${articleId}` : '';

// Umbrales de presentación pública (solo visibilidad; no afectan al panel).
const UMBRAL_LIKES = 3; // «♥» visibles desde 3
const UMBRAL_LECTURAS = 10; // «lecturas» visibles desde 10
---

{apiBase && (
  <section
    class="article-metrics"
    data-api={api}
    data-umbral-likes={UMBRAL_LIKES}
    data-umbral-lecturas={UMBRAL_LECTURAS}
    aria-label="Métricas del artículo"
  >
    <button class="like-button" type="button" data-like aria-live="polite">
      <span aria-hidden="true">♥</span>
      <span class="like-label">Me gusta</span>
      <span class="like-count" data-likes hidden></span>
    </button>
    <span class="metric-reads" data-reads hidden>
      <strong data-lecturas></strong> <span class="metric-label">lecturas</span>
    </span>
  </section>
)}

<style>
  .article-metrics {
    align-items: center;
    display: flex;
    gap: 1rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }

  .like-button {
    align-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: 0.9rem;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
  }

  .like-button:hover:not(:disabled),
  .like-button:focus-visible {
    border-color: var(--color-secondary);
  }

  .like-button.liked {
    background: color-mix(in srgb, var(--color-secondary) 12%, transparent);
    border-color: var(--color-secondary);
    color: var(--color-secondary);
    cursor: default;
    font-weight: 700;
  }

  .like-count {
    font-weight: 700;
  }

  .metric-reads {
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .metric-label {
    opacity: 0.8;
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('.article-metrics[data-api]');
  const api = seccion?.dataset.api;

  if (seccion && api) {
    const slug = api.slice(api.lastIndexOf('/') + 1);
    const boton = seccion.querySelector<HTMLButtonElement>('[data-like]');
    const etiqueta = seccion.querySelector<HTMLElement>('.like-label');
    const likesEl = seccion.querySelector<HTMLElement>('[data-likes]');
    const lecturasEl = seccion.querySelector<HTMLElement>('[data-lecturas]');
    const cajaLecturas = seccion.querySelector<HTMLElement>('[data-reads]');
    const umbralLikes = Number(seccion.dataset.umbralLikes ?? '3');
    const umbralLecturas = Number(seccion.dataset.umbralLecturas ?? '10');
    const likedKey = `ccd-liked-${slug}`;
    const readKey = `ccd-read-${slug}`;

    const traerStats = async () => {
      const res = await fetch(`${api}/stats`);
      if (!res.ok) throw new Error(`API ${res.status}`);
      return (await res.json()) as {
        visitas: number;
        lecturas: number;
        likes: number;
      };
    };

    // Las cifras públicas solo se muestran al superar su umbral (opción A);
    // por debajo el botón sigue funcionando y el lector ve «Te gusta».
    // La medición y el panel no dependen de esta visibilidad.
    const pintarLikes = (n: number) => {
      if (!likesEl) return;
      const visible = n >= umbralLikes;
      likesEl.textContent = visible ? String(n) : '';
      likesEl.hidden = !visible;
    };
    const pintarLecturas = (n: number) => {
      if (lecturasEl) lecturasEl.textContent = String(n);
      if (cajaLecturas) cajaLecturas.hidden = n < umbralLecturas;
    };

    // Estado inicial (conteos + si ya se dio like en este navegador).
    try {
      const stats = await traerStats();
      pintarLikes(stats.likes);
      pintarLecturas(stats.lecturas);
    } catch {
      // Sin API o sin red: los puntos suspensivos quedan como está.
    }

    if (localStorage.getItem(likedKey)) {
      boton?.classList.add('liked');
      boton?.setAttribute('disabled', '');
      if (etiqueta) etiqueta.textContent = 'Te gusta';
    }

    // Visita: una por cada carga de página.
    fetch(`${api}/view`, { method: 'POST', keepalive: true }).catch(() => {});

    // Lectura: ≥75 % de la página, una vez por sesión.
    const marcarLectura = () => {
      if (sessionStorage.getItem(readKey)) return;
      const umbral = document.documentElement.scrollHeight * 0.75;
      if (window.scrollY + window.innerHeight < umbral) return;
      sessionStorage.setItem(readKey, '1');
      window.removeEventListener('scroll', marcarLectura);
      fetch(`${api}/read`, { method: 'POST', keepalive: true })
        .then(() => traerStats())
        .then((stats) => pintarLecturas(stats.lecturas))
        .catch(() => {});
    };
    window.addEventListener('scroll', marcarLectura, { passive: true });
    marcarLectura();

    // Like: uno por navegador.
    boton?.addEventListener('click', async () => {
      if (localStorage.getItem(likedKey) || boton.disabled) return;
      boton.disabled = true;
      try {
        const res = await fetch(`${api}/like`, { method: 'POST' });
        if (!res.ok) throw new Error(`API ${res.status}`);
        const data = (await res.json()) as { likes: number };
        localStorage.setItem(likedKey, '1');
        boton.classList.add('liked');
        if (etiqueta) etiqueta.textContent = 'Te gusta';
        pintarLikes(data.likes);
      } catch {
        boton.disabled = false;
      }
    });
  }
</script>
